[Install]
WantedBy=multi-user.target
EOF

    cat > /etc/systemd/system/argo.service << EOF
[Unit]
Description=Cloudflare Tunnel
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
NoNewPrivileges=yes
Environment="GOGC=30"
Environment="GOMEMLIMIT=32MiB"
Environment="GOMAXPROCS=1"
TimeoutStartSec=0
ExecStart=/bin/sh -c "${argo_cmd}"
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable sing-box >/dev/null 2>&1
    systemctl restart sing-box
    record_service_pid "sing-box" >/dev/null 2>&1 || true

    load_meta
    if proto_exists "vmess-ws" && [ "${ARGO_STOPPED:-0}" != "1" ]; then
        systemctl enable argo >/dev/null 2>&1
        systemctl restart argo
        record_service_pid "argo" >/dev/null 2>&1 || true
    else
        clear_service_pid "argo"
        systemctl stop argo >/dev/null 2>&1 || true
        systemctl disable argo >/dev/null 2>&1 || true
        kill_service_residual "argo"
    fi
}

