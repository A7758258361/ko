    green "6. 修改节点配置 (端口 / UUID / Reality域名 / HY2跳跃 / AnyTLS伪装)"
    echo "=========================================================="
    green "7. sing-box 服务管理"
    green "8. Argo 隧道管理"
    green "9. WARP 分流管理"
    green "10. BBR 加速管理 (开启 / 关闭 BBR 加速通道)"
    green "11. 断联自动重启守护管理 (秒级自启 + 64M防OOM优化)"
