proto_exists() {
    local tag="$1"
    [ -f "${conf_dir}/inbounds.json" ] && jq -e --arg tag "$tag" '.inbounds[] | select(.tag == $tag)' "${conf_dir}/inbounds.json" >/dev/null 2>&1
}

add_proto_to_inbounds() {
    local proto_key="$1"
    local interactive="${2:-1}"
    local inbounds_file="${conf_dir}/inbounds.json"
    load_meta
    local listen_ip="${LISTEN_IP:-::}"

    case "$proto_key" in
        vless|vless-reality)
            if proto_exists "vless-reality"; then
                yellow "vless-reality 已存在，跳过添加。"; return 0
            fi
            ensure_reality_keypair || return 1
            local def_port="${VLESS_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "VLESS-Reality (TCP)" "$def_port" "vless-reality" "tcp"
                def_port="$Selected_Port"
            fi
            save_meta "VLESS_PORT" "$def_port"
            local sni="${REALITY_SNI:-www.iij.ad.jp}"
            save_meta "REALITY_SNI" "$sni"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg uuid "$UUID" \
               --arg sni "$sni" \
               --arg pk "$PRIVATE_KEY" \
               '.inbounds += [{
                   "type": "vless",
                   "tag": "vless-reality",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"uuid": $uuid, "flow": "xtls-rprx-vision"}],
                   "tls": {
                       "enabled": true,
                       "server_name": $sni,
                       "reality": {
                           "enabled": true,
                           "handshake": {"server": $sni, "server_port": 443},
                           "private_key": $pk,
                           "short_id": [""]
                       }
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp"
            ;;

        vmess|vmess-ws)
            if proto_exists "vmess-ws"; then
                yellow "vmess-ws 已存在，跳过添加。"; return 0
            fi
            ensure_argo_binary || return 1
            local def_port="${VMESS_PORT:-8001}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "VMess-WS (Argo本地回环监听)" "$def_port" "vmess-ws" "local"
                def_port="$Selected_Port"
            fi
            save_meta "VMESS_PORT" "$def_port"
            save_meta "ARGO_STOPPED" "0"

            jq --argjson port "$def_port" \
               --arg uuid "$UUID" \
               '.inbounds += [{
                   "type": "vmess",
                   "tag": "vmess-ws",
                   "listen": "127.0.0.1",
                   "listen_port": $port,
                   "users": [{"uuid": $uuid}],
                   "transport": {
                       "type": "ws",
                       "path": "/vmess-argo",
                       "early_data_header_name": "Sec-WebSocket-Protocol"
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            ;;

        hy2|hysteria2)
            if proto_exists "hysteria2"; then
                yellow "hysteria2 已存在，跳过添加。"; return 0
            fi
            local def_port="${HY2_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "Hysteria2 (UDP)" "$def_port" "hysteria2" "udp"
                def_port="$Selected_Port"
            fi
            save_meta "HY2_PORT" "$def_port"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg uuid "$UUID" \
               --arg cert "${work_dir}/cert.pem" \
               --arg key "${work_dir}/private.key" \
               '.inbounds += [{
                   "type": "hysteria2",
                   "tag": "hysteria2",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"password": $uuid}],
                   "ignore_client_bandwidth": false,
                   "masquerade": "https://bing.com",
                   "tls": {
                       "enabled": true,
                       "alpn": ["h3"],
                       "min_version": "1.3",
                       "max_version": "1.3",
                       "certificate_path": $cert,
                       "key_path": $key
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/udp"
            ;;

        tuic|tuic5)
            if proto_exists "tuic"; then
                yellow "tuic 已存在，跳过添加。"; return 0
            fi
            local def_port="${TUIC_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "TUIC-v5 (UDP)" "$def_port" "tuic" "udp"
                def_port="$Selected_Port"
            fi
            save_meta "TUIC_PORT" "$def_port"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg uuid "$UUID" \
               --arg cert "${work_dir}/cert.pem" \
               --arg key "${work_dir}/private.key" \
               '.inbounds += [{
                   "type": "tuic",
                   "tag": "tuic",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"uuid": $uuid, "password": $uuid}],
                   "congestion_control": "bbr",
                   "tls": {
                       "enabled": true,
                       "alpn": ["h3"],
                       "certificate_path": $cert,
                       "key_path": $key
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/udp"
            ;;

        anytls)
            if proto_exists "anytls"; then
                yellow "AnyTLS 已存在，跳过添加。"; return 0
            fi
            local def_port="${ANYTLS_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "AnyTLS (TCP)" "$def_port" "anytls" "tcp"
                def_port="$Selected_Port"
            fi
            prompt_anytls_tls_config "$interactive" || return 1
            save_meta "ANYTLS_PORT" "$def_port"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg pass "$UUID" \
               --argjson tls "$ANYTLS_TLS_JSON" \
               '.inbounds += [{
                   "type": "anytls",
                   "tag": "anytls",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"password": $pass}],
                   "tls": $tls
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp"
            ;;

        socks|socks5|socks5-in)
            if proto_exists "socks5-in"; then
                yellow "Socks5 已存在，跳过添加。"; return 0
            fi
            local def_port="${SOCKS_PORT:-$(rand_port)}"
            local sk_user="${SOCKS_USER:-${UUID:0:8}}"
            local sk_pass="${SOCKS_PASS:-${UUID: -12}}"
            if [ "$interactive" -eq 1 ]; then
                yellow "提示: 明文 Socks5 直接暴露公网极易触发母机风控告警，建议仅在明确允许的环境使用。"
                prompt_custom_port "Socks5 (TCP+UDP)" "$def_port" "socks5-in" "both"
                def_port="$Selected_Port"
                reading "请输入 Socks5 用户名 (直接回车默认 ${sk_user}): " input_u
                [ -n "$input_u" ] && sk_user="$input_u"
                reading "请输入 Socks5 密码 (直接回车默认 ${sk_pass}): " input_pw
                [ -n "$input_pw" ] && sk_pass="$input_pw"
            fi
            save_meta "SOCKS_PORT" "$def_port"
            save_meta "SOCKS_USER" "$sk_user"
            save_meta "SOCKS_PASS" "$sk_pass"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg user "$sk_user" \
               --arg pass "$sk_pass" \
               '.inbounds += [{
                   "type": "socks",
                   "tag": "socks5-in",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"username": $user, "password": $pass}]
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp" "${def_port}/udp"
            ;;

        ss|ss2022|shadowsocks-2022)
            if proto_exists "shadowsocks-2022"; then
                yellow "Shadowsocks-2022 已存在，跳过添加。"; return 0
            fi
            local def_port="${SS_PORT:-$(rand_port)}"
            local ss_method="${SS_METHOD:-2022-blake3-aes-128-gcm}"
            local key_len=16
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "Shadowsocks-2022 (TCP+UDP)" "$def_port" "shadowsocks-2022" "both"
                def_port="$Selected_Port"
                green "请选择 SS2022 加密方式: 1. aes-128-gcm(默认)  2. aes-256-gcm  3. chacha20-poly1305"
                reading "请输入选择 (回车默认1): " m_choice
                case "$m_choice" in
                    2) ss_method="2022-blake3-aes-256-gcm"; key_len=32 ;;
                    3) ss_method="2022-blake3-chacha20-poly1305"; key_len=32 ;;
                    *) ss_method="2022-blake3-aes-128-gcm"; key_len=16 ;;
                esac
            fi
            local ss_key
            ss_key=$(dd if=/dev/urandom bs=1 count=${key_len} 2>/dev/null | b64_encode)
            save_meta "SS_PORT" "$def_port"
            save_meta "SS_METHOD" "$ss_method"
            save_meta "SS_KEY" "$ss_key"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg method "$ss_method" \
               --arg key "$ss_key" \
               '.inbounds += [{
                   "type": "shadowsocks",
                   "tag": "shadowsocks-2022",
                   "listen": $listen,
                   "listen_port": $port,
                   "method": $method,
                   "password": $key,
                   "multiplex": {"enabled": true}
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp" "${def_port}/udp"
            ;;
    esac
}

remove_proto_from_inbounds() {
    local tag="$1"
    local inbounds_file="${conf_dir}/inbounds.json"
    if ! proto_exists "$tag"; then
        yellow "协议 [$tag] 当前未启用，无需删除。"
        return 1
    fi

    local old_port
    old_port=$(jq -r --arg tag "$tag" '.inbounds[] | select(.tag == $tag) | .listen_port' "$inbounds_file")

    jq --arg tag "$tag" 'del(.inbounds[] | select(.tag == $tag))' \
        "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"

    case "$tag" in
        vless-reality|anytls) [ -n "$old_port" ] && revoke_port "${old_port}/tcp" ;;
        hysteria2)
            [ -n "$old_port" ] && revoke_port "${old_port}/udp"
            clean_hy2_mport_rules
            save_meta "HY2_MPORT_MIN" ""
            save_meta "HY2_MPORT_MAX" ""
            save_meta "HY2_MPORT_TARGET" ""
            ;;
        tuic) [ -n "$old_port" ] && revoke_port "${old_port}/udp" ;;
        socks5-in|shadowsocks-2022) [ -n "$old_port" ] && revoke_port "${old_port}/tcp" "${old_port}/udp" ;;
        vmess-ws)
            save_meta "ARGO_STOPPED" "0"
            stop_argo
            if command_exists systemctl; then
                systemctl disable argo >/dev/null 2>&1 || true
            elif command_exists rc-update; then
                rc-update del argo default >/dev/null 2>&1 || true
            fi
            yellow "已同步停止 Argo 进程释放内存。"
            ;;
    esac
    return 0
}

# =========================
# 生成节点列表并输出纯 Base64 编码
# =========================
rebuild_urls() {
    local inbounds_file="${conf_dir}/inbounds.json"
    [ ! -f "$inbounds_file" ] && return 1

    sync_latest_argo_domain || true
    load_meta
    local region
    region=$(get_isp_name)
    local cfip="${CFIP_SAVED:-${CFIP}}"
    local cfport="${CFPORT_SAVED:-${CFPORT}}"

    local addr_list=()
    local stack_list=()
    case "${STACK_MODE}" in
        v4)
            local v4="${NODE_IPV4:-$(detect_ipv4)}"
            addr_list=("${v4:-127.0.0.1}")
            stack_list=("V4")
            ;;
        v6)
            local v6="${NODE_IPV6:-$(detect_ipv6)}"
            v6=$(echo "$v6" | tr -d '[]')
            addr_list=("[${v6:-::1}]")
            stack_list=("V6")
            ;;
        dual)
            local v4="${NODE_IPV4:-$(detect_ipv4)}"
            local v6="${NODE_IPV6:-$(detect_ipv6)}"
            v6=$(echo "$v6" | tr -d '[]')
            [ -n "$v4" ] && { addr_list+=("$v4"); stack_list+=("V4"); }
            [ -n "$v6" ] && { addr_list+=("[${v6}]"); stack_list+=("V6"); }
            if [ "${#addr_list[@]}" -eq 0 ]; then
                addr_list=("127.0.0.1"); stack_list=("V4")
            fi
            ;;
        *)
            local cip="${CUSTOM_NODE_IP:-$(detect_ipv4)}"
            local c_stack="V4"
            [[ "$cip" == *"["*":"*"]" ]] && c_stack="V6"
            addr_list=("${cip:-127.0.0.1}")
            stack_list=("${c_stack}")
            ;;
    esac

    local default_stack="${stack_list[0]:-V4}"
    > "$client_dir"

    if proto_exists "vless-reality"; then
        local v_port v_uuid v_sni remark
        v_port=$(jq -r '.inbounds[] | select(.tag == "vless-reality") | .listen_port' "$inbounds_file")
        v_uuid=$(jq -r '.inbounds[] | select(.tag == "vless-reality") | .users[0].uuid' "$inbounds_file")
        v_sni=$(jq -r '.inbounds[] | select(.tag == "vless-reality") | .tls.server_name' "$inbounds_file")
        for idx in "${!addr_list[@]}"; do
            remark=$(build_node_remark "$region" "${stack_list[$idx]}" "vless-reality")
            echo "vless://${v_uuid}@${addr_list[$idx]}:${v_port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${v_sni}&fp=firefox&pbk=${PUBLIC_KEY}&type=tcp&headerType=none#${remark}" >> "$client_dir"
        done
    fi

    if proto_exists "vmess-ws"; then
        local m_uuid argodomain remark
        m_uuid=$(jq -r '.inbounds[] | select(.tag == "vmess-ws") | .users[0].uuid' "$inbounds_file")
        argodomain="${ARGO_DOMAIN}"
        if [ -z "$ARGO_TOKEN" ] && [ -f "${work_dir}/argo.log" ]; then
            local latest_log_dom
            latest_log_dom=$(sed -n 's|.*https://\([^/]*trycloudflare\.com\).*|\1|p' "${work_dir}/argo.log" 2>/dev/null | tail -1)
            [ -n "$latest_log_dom" ] && argodomain="$latest_log_dom"
        fi
        [ -z "$argodomain" ] && argodomain="argo-pending.trycloudflare.com"
        save_meta "ARGO_DOMAIN" "$argodomain"

        remark=$(build_node_remark "$region" "$default_stack" "vmess-ws")
        local vmess_json
        vmess_json=$(jq -cn \
            --arg ps "$remark" \
            --arg add "$cfip" \
            --arg port "$cfport" \
            --arg id "$m_uuid" \
            --arg host "$argodomain" \
            '{v:"2", ps:$ps, add:$add, port:$port, id:$id, aid:"0", scy:"auto", net:"ws", type:"none", host:$host, path:"/vmess-argo?ed=2560", tls:"tls", sni:$host, alpn:"", fp:"firefox", allowInsecure:"false"}')
        echo "vmess://$(printf '%s' "$vmess_json" | b64_encode)" >> "$client_dir"
    fi

    if proto_exists "hysteria2"; then
        local h_port h_pass mport_str="" remark
        h_port=$(jq -r '.inbounds[] | select(.tag == "hysteria2") | .listen_port' "$inbounds_file")
        h_pass=$(jq -r '.inbounds[] | select(.tag == "hysteria2") | .users[0].password' "$inbounds_file")
        if [ -n "$HY2_MPORT_MIN" ] && [ -n "$HY2_MPORT_MAX" ]; then
            mport_str="&mport=${h_port},${HY2_MPORT_MIN}-${HY2_MPORT_MAX}"
        fi
        for idx in "${!addr_list[@]}"; do
            remark=$(build_node_remark "$region" "${stack_list[$idx]}" "hysteria2")
            echo "hysteria2://${h_pass}@${addr_list[$idx]}:${h_port}/?sni=www.bing.com&insecure=1&pinSHA256=${FINGERPRINT}&alpn=h3&obfs=none${mport_str}#${remark}" >> "$client_dir"
        done
    fi

    if proto_exists "tuic"; then
        local t_port t_uuid t_pass remark
        t_port=$(jq -r '.inbounds[] | select(.tag == "tuic") | .listen_port' "$inbounds_file")
        t_uuid=$(jq -r '.inbounds[] | select(.tag == "tuic") | .users[0].uuid' "$inbounds_file")
        t_pass=$(jq -r '.inbounds[] | select(.tag == "tuic") | .users[0].password' "$inbounds_file")
        for idx in "${!addr_list[@]}"; do
            remark=$(build_node_remark "$region" "${stack_list[$idx]}" "tuic")
            echo "tuic://${t_uuid}:${t_pass}@${addr_list[$idx]}:${t_port}?sni=www.bing.com&congestion_control=bbr&udp_relay_mode=native&alpn=h3&allow_insecure=1#${remark}" >> "$client_dir"
        done
    fi

    if proto_exists "anytls"; then
        local a_port a_pass a_is_reality a_sni a_sid a_cert remark
        a_port=$(jq -r '.inbounds[] | select(.tag == "anytls") | .listen_port' "$inbounds_file")
        a_pass=$(jq -r '.inbounds[] | select(.tag == "anytls") | .users[0].password' "$inbounds_file")
        a_is_reality=$(jq -r '.inbounds[] | select(.tag == "anytls") | .tls.reality.enabled // false' "$inbounds_file")
        a_sni=$(jq -r '.inbounds[] | select(.tag == "anytls") | .tls.server_name // empty' "$inbounds_file")
        a_sid=$(jq -r '.inbounds[] | select(.tag == "anytls") | .tls.reality.short_id[0] // empty' "$inbounds_file")
        a_cert=$(jq -r '.inbounds[] | select(.tag == "anytls") | .tls.certificate_path // empty' "$inbounds_file")

        for idx in "${!addr_list[@]}"; do
            remark=$(build_node_remark "$region" "${stack_list[$idx]}" "anytls")
            if [ "$a_is_reality" == "true" ]; then
                echo "anytls://${a_pass}@${addr_list[$idx]}:${a_port}/?security=reality&sni=${a_sni:-${REALITY_SNI:-www.iij.ad.jp}}&fp=firefox&pbk=${PUBLIC_KEY}${a_sid:+&sid=${a_sid}}#${remark}" >> "$client_dir"
            elif [ -n "$a_cert" ] && [ "$a_cert" != "${work_dir}/cert.pem" ] && [ -n "$a_sni" ]; then
                echo "anytls://${a_pass}@${addr_list[$idx]}:${a_port}/?sni=${a_sni}&insecure=0#${remark}" >> "$client_dir"
            else
                echo "anytls://${a_pass}@${addr_list[$idx]}:${a_port}/?insecure=1&sni=${a_sni:-bing.com}#${remark}" >> "$client_dir"
            fi
        done
    fi

    if proto_exists "socks5-in"; then
        local s_port s_user s_pass s_auth remark
        s_port=$(jq -r '.inbounds[] | select(.tag == "socks5-in") | .listen_port' "$inbounds_file")
        s_user=$(jq -r '.inbounds[] | select(.tag == "socks5-in") | .users[0].username' "$inbounds_file")
        s_pass=$(jq -r '.inbounds[] | select(.tag == "socks5-in") | .users[0].password' "$inbounds_file")
        s_auth=$(printf '%s:%s' "$s_user" "$s_pass" | b64_encode)
        for idx in "${!addr_list[@]}"; do
            remark=$(build_node_remark "$region" "${stack_list[$idx]}" "socks5-in")
            echo "socks://${s_auth}@${addr_list[$idx]}:${s_port}#${remark}" >> "$client_dir"
        done
    fi

    if proto_exists "shadowsocks-2022"; then
        local ss_port ss_method ss_key ss_auth remark
        ss_port=$(jq -r '.inbounds[] | select(.tag == "shadowsocks-2022") | .listen_port' "$inbounds_file")
        ss_method=$(jq -r '.inbounds[] | select(.tag == "shadowsocks-2022") | .method' "$inbounds_file")
        ss_key=$(jq -r '.inbounds[] | select(.tag == "shadowsocks-2022") | .password' "$inbounds_file")
        ss_auth=$(printf '%s:%s' "$ss_method" "$ss_key" | b64_encode)
        for idx in "${!addr_list[@]}"; do
            remark=$(build_node_remark "$region" "${stack_list[$idx]}" "shadowsocks-2022")
            echo "ss://${ss_auth}@${addr_list[$idx]}:${ss_port}#${remark}" >> "$client_dir"
        done
    fi

    if [ -s "$client_dir" ]; then
        b64_encode < "$client_dir" > "$sub_file"
    else
        > "$sub_file"
    fi
}

check_nodes() {
    if proto_exists "vmess-ws" && sync_latest_argo_domain; then
        rebuild_urls >/dev/null 2>&1 || true
    fi
    if [ ! -f "${sub_file}" ] || [ ! -s "${sub_file}" ]; then
        red "\n当前没有已生成的节点 Base64 数据，请先安装或添加协议。\n"
        return 1
    fi
    echo ""
    green "==================== 节点 Base64 编码 ===================="
    echo ""
    echo -e "${purple}$(cat "${sub_file}")${re}"
    echo ""
    green "=========================================================="
    echo ""
}

select_install_protocols() {
    echo ""
    purple "=== 选择要生成的协议节点 (支持多选) ==="
    green "  1. vless-reality       (极低内存，TCP强伪装抗探测)"
    green "  2. vmess-ws + Argo隧道 (套CF隧道，需运行argo进程约占20M内存)"
    green "  3. hysteria2           (UDP高速协议)"
    green "  4. tuic v5             (UDP低延迟协议)"
    green "  5. AnyTLS              (默认 Reality 强伪装，抗探测免自签告警)"
    yellow "  6. Socks5              (明文代理，公网暴露易触发母机风控，慎用)"
    green "  7. Shadowsocks-2022    (轻量级SS2022加密协议)"
    skyblue "--------------------------------------------------------"
    yellow "提示: 多个协议请用空格或逗号隔开 (例如: 1 3 5 或 1,3,7)"
    yellow "      直接回车默认生成 [1 3 4] (vless + hy2 + tuic，免Argo极省内存)"
    reading "请输入协议编号 (回车默认 1 3 4): " proto_input

    if [ -z "$proto_input" ]; then
        SELECTED_PROTOS="1 3 4"
    else
        SELECTED_PROTOS=$(echo "$proto_input" | tr ',' ' ')
    fi
}

install_singbox() {
    optimize_low_memory
    clear
    purple "=== 开始配置并安装 sing-box (64M轻量稳定版) ==="

    enable_bbr
    configure_inbound_stack_and_ip

    SELECTED_PROTOS=""
    select_install_protocols

    mkdir -p "${work_dir}" "${conf_dir}"
    chmod 755 "${work_dir}"

    rm -f "${conf_dir}/endpoints.json"

    ensure_singbox_binary

    local uuid output private_key public_key fingerprint
    uuid=$(cat /proc/sys/kernel/random/uuid)
    output=$("${work_dir}/sing-box" generate reality-keypair)
    private_key=$(echo "${output}" | awk '/PrivateKey:/ {print $2}')
    public_key=$(echo "${output}" | awk '/PublicKey:/ {print $2}')

    openssl ecparam -genkey -name prime256v1 -out "${work_dir}/private.key" >/dev/null 2>&1
    openssl req -new -x509 -days 3650 -key "${work_dir}/private.key" -out "${work_dir}/cert.pem" -subj "/CN=bing.com" >/dev/null 2>&1
    fingerprint=$(openssl x509 -noout -fingerprint -sha256 -in "${work_dir}/cert.pem" | cut -d'=' -f2 | sed 's/:/%3A/g')

    save_meta "UUID" "$uuid"
    save_meta "PRIVATE_KEY" "$private_key"
    save_meta "PUBLIC_KEY" "$public_key"
    save_meta "FINGERPRINT" "$fingerprint"
    save_meta "REALITY_SNI" "www.iij.ad.jp"
    save_meta "CFIP_SAVED" "$CFIP"
    save_meta "CFPORT_SAVED" "$CFPORT"
    save_meta "ARGO_DOMAIN" ""
    save_meta "ARGO_TOKEN" ""
    save_meta "ARGO_STOPPED" "0"

    local dns_strategy="prefer_ipv4"
    load_meta
    [ "$STACK_MODE" == "v6" ] && dns_strategy="prefer_ipv6"

    cat > "${conf_dir}/log.json" << EOF
{
  "log": {
    "disabled": false,
    "level": "error",
    "output": "$work_dir/sb.log",
    "timestamp": true
  }
}
EOF

    cat > "${conf_dir}/ntp.json" << EOF
{
  "ntp": {
    "enabled": true,
    "server": "time.apple.com",
    "server_port": 123,
    "interval": "60m"
  }
}
EOF

    cat > "${conf_dir}/dns.json" << EOF
{
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "strategy": "$dns_strategy"
  }
}
EOF

    echo '{"inbounds": []}' > "${conf_dir}/inbounds.json"
    echo ""
    purple "=== 请为所选协议设置监听端口 (支持 TCP 与 UDP 协议复用同一端口) ==="
    for item in $SELECTED_PROTOS; do
        case "$item" in
            1|vless)   add_proto_to_inbounds "vless-reality" 1 ;;
            2|vmess)   add_proto_to_inbounds "vmess-ws" 1 ;;
            3|hy2)     add_proto_to_inbounds "hysteria2" 1 ;;
            4|tuic)    add_proto_to_inbounds "tuic" 1 ;;
            5|anytls)  add_proto_to_inbounds "anytls" 1 ;;
            6|socks5)  add_proto_to_inbounds "socks5-in" 1 ;;
            7|ss2022)  add_proto_to_inbounds "shadowsocks-2022" 1 ;;
        esac
    done

    cat > "${conf_dir}/outbounds.json" << EOF
{
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
EOF

    cat > "${conf_dir}/route.json" << EOF
{
  "route": {
    "rule_set": [],
    "rules": [],
    "final": "direct",
    "default_domain_resolver": "local"
  }
}
EOF
}

# 加入 --ha-connections 1 减少 75% 隧道并发连接内存开销，避免 64M 小鸡重启握手卡死
get_argo_exec_cmd() {
    load_meta
    local argo_p="${VMESS_PORT:-8001}"
    if [ -n "$ARGO_TOKEN" ]; then
        printf "exec /etc/sing-box/argo tunnel --edge-ip-version auto --no-autoupdate --ha-connections 1 --protocol http2 run --token '%s' >> /etc/sing-box/argo.log 2>&1" "${ARGO_TOKEN//\'/}"
    else
        printf "exec /etc/sing-box/argo tunnel --url http://127.0.0.1:%s --no-autoupdate --edge-ip-version auto --ha-connections 1 --protocol http2 >> /etc/sing-box/argo.log 2>&1" "$argo_p"
    fi
}

get_argo_args() {
    load_meta
    local argo_p="${VMESS_PORT:-8001}"
    if [ -n "$ARGO_TOKEN" ]; then
        echo "tunnel --edge-ip-version auto --no-autoupdate --ha-connections 1 --protocol http2 run --token ${ARGO_TOKEN//\'/}"
    else
        echo "tunnel --url http://127.0.0.1:${argo_p} --no-autoupdate --edge-ip-version auto --ha-connections 1 --protocol http2"
    fi
}

main_systemd_services() {
    local argo_cmd sb_mem_limit
    argo_cmd=$(get_argo_exec_cmd)
    sb_mem_limit=$(get_sb_mem_limit)

    cat > /etc/systemd/system/sing-box.service << EOF
[Unit]
Description=sing-box service
After=network.target nss-lookup.target
StartLimitIntervalSec=0

[Service]
User=root
WorkingDirectory=/etc/sing-box
Environment="GOGC=20"
Environment="GOMEMLIMIT=${sb_mem_limit}"
Environment="GOMAXPROCS=1"
