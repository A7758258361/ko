    local inbounds_file="${conf_dir}/inbounds.json"
    if [ -f "$inbounds_file" ] && command_exists jq; then
        echo -e " 2. 已启用协议端口监听 :"
        local tag port ptype trans
        while IFS='|' read -r tag port ptype; do
            [ -z "$tag" ] && continue
            trans="tcp"
            [ "$ptype" == "hysteria2" ] || [ "$ptype" == "tuic" ] && trans="udp"
            [ "$ptype" == "socks" ] || [ "$ptype" == "shadowsocks" ] && trans="both"
            if is_system_port_used "$port" "$trans"; then
                printf "    - %-18s (端口 %-5s / %-4s) : ${green}监听正常${re}\n" "$tag" "$port" "$trans"
            else
                printf "    - %-18s (端口 %-5s / %-4s) : ${red}未检测到监听${re}\n" "$tag" "$port" "$trans"
            fi
        done < <(jq -r '.inbounds[] | "\(.tag)|\(.listen_port)|\(.type)"' "$inbounds_file" 2>/dev/null)
    fi

    if proto_exists "vmess-ws"; then
        if [ "$(check_service_raw argo)" == "running" ]; then
            echo -e " 3. Argo 隧道进程      : ${green}运行正常${re}"
        else
            echo -e " 3. Argo 隧道进程      : ${yellow}未运行${re}"
        fi
    fi

    local g_out g_code g_ms
    g_out=$(curl -s -o /dev/null -w "%{http_code}|%{time_starttransfer}" --max-time 5 "https://www.gstatic.com/generate_204" 2>/dev/null)
    g_code="${g_out%%|*}"
    g_ms=$(awk -v t="${g_out#*|}" 'BEGIN {printf "%.0f", t * 1000}')
    if [ "$g_code" == "204" ] || [ "$g_code" == "200" ]; then
        echo -e " 4. Google 204 出口    : ${green}畅通 (HTTP ${g_code} | ${g_ms} ms)${re}"
    else
        echo -e " 4. Google 204 出口    : ${red}异常 (HTTP ${g_code:-超时})${re}"
    fi

    local doh_enabled=0 doh_srv=""
    if [ -f "${conf_dir}/dns.json" ] && command_exists jq; then
        if [ "$(jq -r '.dns.servers[0].type // "local"' "${conf_dir}/dns.json" 2>/dev/null)" == "https" ]; then
            doh_enabled=1
            doh_srv=$(jq -r '.dns.servers[0].server // empty' "${conf_dir}/dns.json" 2>/dev/null)
        fi
    fi

    local cf_code
    cf_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 4 "https://speed.cloudflare.com/__down?bytes=1000" 2>/dev/null)
    if [ "$cf_code" == "200" ]; then
        echo -e " 5. Cloudflare 测速口  : ${green}直连畅通 (HTTP 200)${re}"
    else
        local cf_doh_code
        cf_doh_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 4 --resolve "dns.google:443:8.8.8.8" --doh-url "https://dns.google/dns-query" "https://speed.cloudflare.com/__down?bytes=1000" 2>/dev/null)
        if [ "$cf_doh_code" == "200" ]; then
            if [ "$doh_enabled" -eq 1 ]; then
                echo -e " 5. Cloudflare 测速口  : ${green}节点已开启加密DoH (${doh_srv}) 绕过母机限制，测速畅通${re}"
            else
                echo -e " 5. Cloudflare 测速口  : ${yellow}系统DNS受限，但加密DoH畅通 (建议进菜单 12 开启DoH)${re}"
            fi
        else
            echo -e " 5. Cloudflare 测速口  : ${yellow}暂不可达 (HTTP ${cf_code:-超时})${re}"
        fi
    fi

    local risk_notes=()
    if proto_exists "anytls" && [ "$(get_anytls_mode_label)" == "自签证书-易被风控" ]; then
        risk_notes+=("AnyTLS 仍在使用自签假证书 (建议进菜单 6 -> 7 升级为 Reality)")
    fi
    if proto_exists "socks5-in"; then
        risk_notes+=("公网启用了明文 Socks5 (易被母机扫描告警，建议进菜单 4 删除)")
    fi
    if [ "${#risk_notes[@]}" -eq 0 ]; then
        echo -e " 6. 抗探测合规检查     : ${green}通过 (无公网明文协议或 TCP 自签伪装)${re}"
    else
        echo -e " 6. 抗探测合规检查     : ${yellow}存在风控告警风险${re}"
        local note
        for note in "${risk_notes[@]}"; do
            echo -e "    - ${yellow}${note}${re}"
        done
    fi
    green "=============================================================="
    echo ""
}

format_speed_str() {
    local bps="$1"
    awk -v b="$bps" 'BEGIN {
        if (b + 0 <= 0) { printf "0.00 MB/s (0.00 Mbps)" }
        else { printf "%.2f MB/s (%.2f Mbps)", b / 1048576, (b * 8) / 1000000 }
    }'
}

run_speedtest() {
    echo ""
    green "================ 服务器轻量级测速 (单线程防OOM) ================"
    yellow "正在检测最佳测速通道，请稍候 (全程零磁盘写入，约耗时 10-20 秒)..."
    echo ""

    local doh_args=()
    local cf_test_code
    cf_test_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 4 "https://speed.cloudflare.com/__down?bytes=1000" 2>/dev/null)
    if [ "$cf_test_code" != "200" ]; then
        local v4_ok v6_ok
        v4_ok=$(curl -s -o /dev/null -w "%{http_code}" --max-time 4 --resolve "dns.google:443:8.8.8.8" --doh-url "https://dns.google/dns-query" "https://speed.cloudflare.com/__down?bytes=1000" 2>/dev/null)
        if [ "$v4_ok" == "200" ]; then
            doh_args=(--resolve "dns.google:443:8.8.8.8" --doh-url "https://dns.google/dns-query")
            yellow "提示: 检测到系统 DNS 无法解析 Cloudflare，本次测速已自动借道 Google IPv4 DoH。"
        else
            v6_ok=$(curl -s -o /dev/null -w "%{http_code}" --max-time 4 --resolve "dns.google:443:2001:4860:4860::8888" --doh-url "https://dns.google/dns-query" "https://speed.cloudflare.com/__down?bytes=1000" 2>/dev/null)
            if [ "$v6_ok" == "200" ]; then
                doh_args=(--resolve "dns.google:443:2001:4860:4860::8888" --doh-url "https://dns.google/dns-query")
                yellow "提示: 检测到系统 DNS 无法解析 Cloudflare，本次测速已自动借道 Google IPv6 DoH。"
            fi
        fi
    fi

    local cf_rtt cf_rtt_ms cf_dl_bps cf_ul_bps
    cf_rtt=$(curl -s -o /dev/null -w "%{time_starttransfer}" --max-time 5 "${doh_args[@]}" "https://speed.cloudflare.com/__down?bytes=1000" 2>/dev/null)
    cf_rtt_ms=$(awk -v t="${cf_rtt:-0}" 'BEGIN {printf "%.0f", t * 1000}')
    if [ "${cf_rtt_ms:-0}" -gt 0 ]; then
        echo -e " Cloudflare 节点延迟   : ${skyblue}${cf_rtt_ms} ms${re}"
        cf_dl_bps=$(curl -s -o /dev/null -w "%{speed_download}" --max-time 12 "${doh_args[@]}" "https://speed.cloudflare.com/__down?bytes=20000000" 2>/dev/null)
        echo -e " Cloudflare 单线程下行 : ${green}$(format_speed_str "${cf_dl_bps:-0}")${re}"
        cf_ul_bps=$(dd if=/dev/zero bs=1048576 count=5 2>/dev/null | curl -s -o /dev/null -w "%{speed_upload}" --max-time 12 "${doh_args[@]}" -X POST --data-binary @- "https://speed.cloudflare.com/__up" 2>/dev/null)
        echo -e " Cloudflare 单线程上行 : ${green}$(format_speed_str "${cf_ul_bps:-0}")${re}"
    else
        echo -e " Cloudflare 测速通道   : ${yellow}连接超时，已跳过${re}"
    fi

    local cache_dl_bps
    cache_dl_bps=$(curl -s -o /dev/null -w "%{speed_download}" --max-time 10 "https://cachefly.cachefly.net/10mb.test" 2>/dev/null)
    if awk -v b="${cache_dl_bps:-0}" 'BEGIN {exit !(b + 0 > 1000)}'; then
        echo -e " CacheFly   单线程下行 : ${green}$(format_speed_str "${cache_dl_bps:-0}")${re}"
    else
        echo -e " CacheFly   单线程下行 : ${yellow}不可达 / 超时${re}"
    fi

    green "================================================================"
    echo ""
}

