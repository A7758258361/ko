# =========================
# 极简依赖安装
# =========================
manage_packages() {
    local action=$1
    shift
    if [ "$action" == "install" ]; then
        local need_update=0
        for pkg in "$@"; do
            if [ "$pkg" == "coreutils" ] && command_exists base64; then continue; fi
            command_exists "$pkg" || need_update=1
        done
        if [ "$need_update" -eq 1 ]; then
            yellow "正在检查并安装基础依赖工具..."
            if command_exists apt-get; then
                DEBIAN_FRONTEND=noninteractive apt-get update -y -o Acquire::Languages=none >/dev/null 2>&1 || true
            elif command_exists apk; then
                apk update >/dev/null 2>&1 || true
            fi
        fi
        for package in "$@"; do
            if [ "$package" == "coreutils" ] && command_exists base64; then continue; fi
            command_exists "$package" && continue
            if command_exists apt-get; then
                DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$package" >/dev/null 2>&1
            elif command_exists dnf; then
                dnf install -y "$package" >/dev/null 2>&1
            elif command_exists yum; then
                yum install -y "$package" >/dev/null 2>&1
            elif command_exists apk; then
                apk add --no-cache "$package" >/dev/null 2>&1
            fi
        done
    fi
}

# =========================
# IPv4 / IPv6 检测与入站模式配置
# =========================
detect_ipv4() {
    local ip
    ip=$(curl -4 -sm 3 ip.sb || curl -4 -sm 3 api.ipify.org || curl -4 -sm 3 ifconfig.me)
    if printf '%s' "$ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        echo "$ip"
    else
        echo ""
    fi
}

detect_ipv6() {
    local v6
    v6=$(curl -6 -sm 3 ip.sb || curl -6 -sm 3 api64.ipify.org || curl -6 -sm 3 ifconfig.me)
    if printf '%s' "$v6" | grep -Eq '^[0-9a-fA-F:]+$'; then
        echo "$v6"
    else
        echo ""
    fi
}

get_isp_name() {
    load_meta
    if [ -n "$ISP_NAME" ]; then
        echo "$ISP_NAME"
        return
    fi
    local isp
    isp=$(curl -sm 3 -H "User-Agent: Mozilla/5.0" "https://api.ip.sb/geoip" | tr -d '\n' | \
        awk -F\" '{c="";i="";for(x=1;x<=NF;x++){if($x=="country_code")c=$(x+2);if($x=="isp")i=$(x+2)};if(c&&i)print c"-"i}' | \
        sed 's/[^a-zA-Z0-9_-]/_/g')
    [ -z "$isp" ] && isp=$(hostname 2>/dev/null | sed 's/[^a-zA-Z0-9_-]/_/g' || echo "Node")
    save_meta "ISP_NAME" "$isp"
    echo "$isp"
}

configure_inbound_stack_and_ip() {
    yellow "\n正在检测服务器 IPv4 / IPv6 地址..."
    local auto_v4 auto_v6
    auto_v4=$(detect_ipv4)
    auto_v6=$(detect_ipv6)

    echo ""
    green "=== 设置入站网络模式 (IPv4 / IPv6 / 双栈) ==="
    echo -e " 检测到公网 IPv4 : ${skyblue}${auto_v4:-未检测到}${re}"
    echo -e " 检测到公网 IPv6 : ${skyblue}${auto_v6:-未检测到}${re}"
    echo ""
    green "  1. 纯 IPv4 模式       (服务端监听 0.0.0.0，节点使用 IPv4 地址)"
    green "  2. 纯 IPv6 模式       (服务端监听 ::，节点使用 [IPv6] 地址)"
    green "  3. 双栈模式 [v4+v6]   (服务端监听 ::，同时生成 IPv4 和 IPv6 两条节点)"
    green "  4. 双栈监听 + 自定义单入站地址 (服务端监听 ::，手动指定节点连接 IP/域名)"
    skyblue "--------------------------------------------------------"
    reading "请选择入站模式 (1-4，直接回车默认选 3 双栈，若仅单栈则自动适配): " stack_choice

    case "$stack_choice" in
        1)
            save_meta "STACK_MODE" "v4"
            save_meta "LISTEN_IP" "0.0.0.0"
            reading "请输入节点入站 IPv4 地址 (直接回车使用 ${auto_v4:-127.0.0.1}): " input_v4
            save_meta "NODE_IPV4" "${input_v4:-${auto_v4:-127.0.0.1}}"
            ;;
        2)
            save_meta "STACK_MODE" "v6"
            save_meta "LISTEN_IP" "::"
            reading "请输入节点入站 IPv6 地址，无需中括号 (直接回车使用 ${auto_v6:-::1}): " input_v6
            input_v6=$(echo "${input_v6:-${auto_v6:-::1}}" | tr -d '[]')
            save_meta "NODE_IPV6" "$input_v6"
            ;;
        4)
            save_meta "STACK_MODE" "custom"
            save_meta "LISTEN_IP" "::"
            local default_custom="${auto_v4:-${auto_v6}}"
            reading "请输入自定义入站 IP 或域名 (直接回车使用 ${default_custom}): " input_custom
            input_custom="${input_custom:-$default_custom}"
            if [[ "$input_custom" == *":"* ]] && [[ "$input_custom" != "["* ]]; then
                input_custom="[${input_custom}]"
            fi
            save_meta "CUSTOM_NODE_IP" "$input_custom"
            ;;
        *)
            save_meta "LISTEN_IP" "::"
            if [ -n "$auto_v4" ] && [ -n "$auto_v6" ]; then
                save_meta "STACK_MODE" "dual"
                reading "请输入 IPv4 节点地址 (回车默认 ${auto_v4}): " input_v4
                reading "请输入 IPv6 节点地址，无需括号 (回车默认 ${auto_v6}): " input_v6
                save_meta "NODE_IPV4" "${input_v4:-$auto_v4}"
                save_meta "NODE_IPV6" "$(echo "${input_v6:-$auto_v6}" | tr -d '[]')"
            elif [ -n "$auto_v4" ]; then
                yellow "未检测到可用 IPv6，已开启双栈监听 (::) 并使用 IPv4 生成节点。"
                save_meta "STACK_MODE" "v4"
                reading "请输入节点入站 IPv4 地址 (回车默认 ${auto_v4}): " input_v4
                save_meta "NODE_IPV4" "${input_v4:-$auto_v4}"
            elif [ -n "$auto_v6" ]; then
                yellow "未检测到可用 IPv4，已开启双栈监听 (::) 并使用 IPv6 生成节点。"
                save_meta "STACK_MODE" "v6"
                reading "请输入节点入站 IPv6 地址，无需括号 (回车默认 ${auto_v6}): " input_v6
                save_meta "NODE_IPV6" "$(echo "${input_v6:-$auto_v6}" | tr -d '[]')"
            else
                save_meta "STACK_MODE" "custom"
                reading "未能自动检测到公网IP，请手动输入节点入站 IP 或域名: " input_custom
                if [[ "$input_custom" == *":"* ]] && [[ "$input_custom" != "["* ]]; then
                    input_custom="[${input_custom}]"
                fi
                save_meta "CUSTOM_NODE_IP" "${input_custom:-127.0.0.1}"
            fi
            ;;
    esac

    load_meta
    if [ -f "${conf_dir}/inbounds.json" ]; then
        jq --arg lip "${LISTEN_IP:-::}" '(.inbounds[] | select(.tag != "vmess-ws") | .listen) = $lip' \
            "${conf_dir}/inbounds.json" > "${conf_dir}/inbounds.json.tmp" && \
            mv "${conf_dir}/inbounds.json.tmp" "${conf_dir}/inbounds.json"
    fi

    if [ -f "${conf_dir}/dns.json" ]; then
        local new_dns_strategy="prefer_ipv4"
        [ "$STACK_MODE" == "v6" ] && new_dns_strategy="prefer_ipv6"
        jq --arg strat "$new_dns_strategy" '.dns.strategy = $strat' \
            "${conf_dir}/dns.json" > "${conf_dir}/dns.json.tmp" && \
            mv "${conf_dir}/dns.json.tmp" "${conf_dir}/dns.json"
    fi
}

# =========================
# 防火墙放行、单端口撤销与全量清理
# =========================
allow_port() {
    local has_ufw=0 has_firewalld=0 has_iptables=0 has_ip6tables=0
    command_exists ufw && has_ufw=1
    command_exists firewall-cmd && systemctl is-active firewalld >/dev/null 2>&1 && has_firewalld=1
    command_exists iptables && has_iptables=1
    command_exists ip6tables && has_ip6tables=1

    mkdir -p "$work_dir"
    touch "$ports_file"

    for rule in "$@"; do
        local port=${rule%/*}
        local proto=${rule#*/}
        [ -z "$port" ] || [ -z "$proto" ] && continue

        grep -qxF "${port}/${proto}" "$ports_file" 2>/dev/null || echo "${port}/${proto}" >> "$ports_file"

        [ "$has_ufw" -eq 1 ] && ufw allow in "${port}/${proto}" >/dev/null 2>&1
        [ "$has_firewalld" -eq 1 ] && firewall-cmd --permanent --add-port="${port}/${proto}" >/dev/null 2>&1
        [ "$has_iptables" -eq 1 ] && (iptables -C INPUT -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null)
        [ "$has_ip6tables" -eq 1 ] && (ip6tables -C INPUT -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null || ip6tables -I INPUT 1 -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null)
    done
    [ "$has_firewalld" -eq 1 ] && firewall-cmd --reload >/dev/null 2>&1
}

revoke_port() {
    local has_firewalld=0
    command_exists firewall-cmd && systemctl is-active firewalld >/dev/null 2>&1 && has_firewalld=1

    for rule in "$@"; do
        local port=${rule%/*}
        local proto=${rule#*/}
        [ -z "$port" ] || [ -z "$proto" ] && continue

        command_exists ufw && ufw delete allow in "${port}/${proto}" >/dev/null 2>&1 || true
        [ "$has_firewalld" -eq 1 ] && firewall-cmd --permanent --remove-port="${port}/${proto}" >/dev/null 2>&1 || true
        command_exists iptables && iptables -D INPUT -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1 || true
        command_exists ip6tables && ip6tables -D INPUT -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1 || true

        if [ -f "$ports_file" ]; then
            grep -vxF "${port}/${proto}" "$ports_file" > "${ports_file}.tmp" 2>/dev/null || true
            mv -f "${ports_file}.tmp" "$ports_file"
        fi
    done
    [ "$has_firewalld" -eq 1 ] && firewall-cmd --reload >/dev/null 2>&1 || true
}

clean_hy2_mport_rules() {
    load_meta
    local target_p="${HY2_MPORT_TARGET:-${HY2_PORT}}"
    if [ -n "$HY2_MPORT_MIN" ] && [ -n "$HY2_MPORT_MAX" ] && [ -n "$target_p" ]; then
        while command_exists iptables && iptables -t nat -C PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" 2>/dev/null; do
            iptables -t nat -D PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" >/dev/null 2>&1 || break
        done
        while command_exists ip6tables && ip6tables -t nat -C PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" 2>/dev/null; do
            ip6tables -t nat -D PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" >/dev/null 2>&1 || break
        done
    fi
}

apply_hy2_mport_rules() {
    local min_p="$1"
    local max_p="$2"
    local target_p="$3"
    clean_hy2_mport_rules

    local applied=0
    if command_exists iptables && iptables -t nat -A PREROUTING -p udp --dport "${min_p}:${max_p}" -j DNAT --to-destination ":${target_p}" 2>/dev/null; then
        applied=1
    fi
    if command_exists ip6tables && ip6tables -t nat -A PREROUTING -p udp --dport "${min_p}:${max_p}" -j DNAT --to-destination ":${target_p}" 2>/dev/null; then
        applied=1
    fi

    if [ "$applied" -eq 1 ]; then
        save_meta "HY2_MPORT_MIN" "$min_p"
        save_meta "HY2_MPORT_MAX" "$max_p"
        save_meta "HY2_MPORT_TARGET" "$target_p"
        green "已成功设置 Hysteria2 端口跳跃 (${min_p}-${max_p} -> ${target_p})！"
        return 0
    else
        red "错误: 当前虚拟化容器内核不支持 iptables NAT PREROUTING 端口转发，无法启用端口跳跃！"
        save_meta "HY2_MPORT_MIN" ""
        save_meta "HY2_MPORT_MAX" ""
        save_meta "HY2_MPORT_TARGET" ""
        return 1
    fi
}

restore_firewall_rules() {
    if [ -f "$ports_file" ]; then
        while IFS= read -r rule; do
            [ -z "$rule" ] && continue
            local port=${rule%/*}
            local proto=${rule#*/}
            [ -z "$port" ] || [ -z "$proto" ] && continue
            command_exists iptables && (iptables -C INPUT -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null || true)
            command_exists ip6tables && (ip6tables -C INPUT -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null || ip6tables -I INPUT 1 -p "${proto}" --dport "${port}" -j ACCEPT 2>/dev/null || true)
        done < "$ports_file"
    fi

    load_meta
    local target_p="${HY2_MPORT_TARGET:-${HY2_PORT}}"
    if proto_exists "hysteria2" && [ -n "$HY2_MPORT_MIN" ] && [ -n "$HY2_MPORT_MAX" ] && [ -n "$target_p" ]; then
        command_exists iptables && (iptables -t nat -C PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" 2>/dev/null || iptables -t nat -A PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" 2>/dev/null || true)
        command_exists ip6tables && (ip6tables -t nat -C PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" 2>/dev/null || ip6tables -t nat -A PREROUTING -p udp --dport "${HY2_MPORT_MIN}:${HY2_MPORT_MAX}" -j DNAT --to-destination ":${target_p}" 2>/dev/null || true)
    fi
}

clean_firewall_rules() {
    if [ -f "$ports_file" ]; then
        while IFS= read -r rule; do
            [ -z "$rule" ] && continue
            local port=${rule%/*}
            local proto=${rule#*/}
            command_exists ufw && ufw delete allow in "${port}/${proto}" >/dev/null 2>&1 || true
            command_exists firewall-cmd && firewall-cmd --permanent --remove-port="${port}/${proto}" >/dev/null 2>&1 || true
            command_exists iptables && iptables -D INPUT -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1 || true
            command_exists ip6tables && ip6tables -D INPUT -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1 || true
        done < "$ports_file"
        command_exists firewall-cmd && firewall-cmd --reload >/dev/null 2>&1 || true
    fi
    clean_hy2_mport_rules
}

# =========================
# 端口输入与按传输层协议 (TCP/UDP) 冲突校验函数
# =========================
is_system_port_used() {
    local p="$1"
    local trans="${2:-both}"
    local ss_flag="-tuln"
    [ "$trans" == "tcp" ] || [ "$trans" == "local" ] && ss_flag="-tln"
    [ "$trans" == "udp" ] && ss_flag="-uln"

    if command_exists ss; then
        ss "$ss_flag" 2>/dev/null | awk '{print $5}' | grep -Eq "(:|\])${p}$" && return 0
    elif command_exists lsof; then
        if [ "$trans" == "tcp" ] || [ "$trans" == "local" ]; then
            lsof -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 && return 0
        elif [ "$trans" == "udp" ]; then
            lsof -iUDP:"$p" >/dev/null 2>&1 && return 0
        else
            lsof -i :"$p" >/dev/null 2>&1 && return 0
        fi
    elif command_exists netstat; then
        netstat "$ss_flag" 2>/dev/null | awk '{print $4}' | grep -Eq "(:|\])${p}$" && return 0
    fi
    return 1
}

is_port_owned_by_singbox() {
    local p="$1"
    local trans="${2:-both}"
    local ss_flag="-tulnp"
    [ "$trans" == "tcp" ] || [ "$trans" == "local" ] && ss_flag="-tlnp"
    [ "$trans" == "udp" ] && ss_flag="-ulnp"

    if command_exists ss; then
        ss "$ss_flag" 2>/dev/null | grep -E "(:|\])${p}[[:space:]]" | grep -q "sing-box" && return 0
    fi
    if command_exists lsof; then
        lsof -i :"$p" 2>/dev/null | grep -q "sing-box" && return 0
    fi
    return 1
}

prompt_custom_port() {
    local proto_title="$1"
    local default_p="$2"
    local current_tag="${3:-}"
    local proto_trans="${4:-both}"
    local chosen_p=""

    while true; do
        reading "请指定 [${proto_title}] 监听端口 (1-65535，直接回车使用 ${default_p}): " chosen_p
        chosen_p="${chosen_p:-$default_p}"

        if [[ ! "$chosen_p" =~ ^[0-9]+$ ]] || [ "$chosen_p" -lt 1 ] || [ "$chosen_p" -gt 65535 ]; then
            yellow "端口无效，请输入 1 到 65535 之间的数字！"
            continue
        fi

        if [ -f "${conf_dir}/inbounds.json" ]; then
            if jq -e --argjson p "$chosen_p" --arg ctag "$current_tag" --arg ptrans "$proto_trans" '
                def trans(t):
                    if (t == "hysteria2" or t == "tuic") then "udp"
                    elif (t == "socks" or t == "shadowsocks") then "both"
                    else "tcp" end;
                .inbounds[] | select(
                    .tag != $ctag and .listen_port == $p and
                    ($ptrans == "both" or trans(.type) == "both" or trans(.type) == $ptrans)
                )
            ' "${conf_dir}/inbounds.json" >/dev/null 2>&1; then
                yellow "端口 ${chosen_p} (${proto_trans}) 已被配置内其他同传输层协议占用，请重新指定！"
                default_p=$(rand_port)
                continue
            fi
        fi

        if is_system_port_used "$chosen_p" "$proto_trans"; then
            if is_port_owned_by_singbox "$chosen_p" "$proto_trans"; then
                :
            else
                yellow "端口 ${chosen_p} 已被系统其他服务占用，请重新指定！"
                default_p=$(rand_port)
                continue
            fi
        fi
        break
    done
    Selected_Port="$chosen_p"
    green " -> [${proto_title}] 端口已设为: ${purple}${Selected_Port}${re}"
}

get_arch() {
    case "$(uname -m)" in
        'x86_64' | 'amd64')  echo 'amd64' ;;
        'x86' | 'i686' | 'i386') echo '386' ;;
        'aarch64' | 'arm64') echo 'arm64' ;;
        'armv7l')  echo 'armv7' ;;
        's390x')   echo 's390x' ;;
        *) red "不支持的架构: $(uname -m)"; exit 1 ;;
    esac
}

# =========================
# 二进制安全下载与可执行性校验
# =========================
ensure_singbox_binary() {
    if [ -x "${work_dir}/${server_name}" ] && "${work_dir}/${server_name}" version >/dev/null 2>&1; then
        return 0
    fi
    local arch
    arch=$(get_arch)
    yellow "\n正在下载并校验 sing-box 核心组件..."
    rm -f "${work_dir}/${server_name}"

    curl -sLo "${work_dir}/${server_name}" "https://${arch}.eooce.com/sb"
    chmod +x "${work_dir}/${server_name}" 2>/dev/null || true

    if ! "${work_dir}/${server_name}" version >/dev/null 2>&1; then
        red "错误: 下载的 sing-box 二进制文件损坏或无法在当前架构执行！"
        rm -f "${work_dir}/${server_name}"
        exit 1
    fi
}

ensure_argo_binary() {
    if [ -x "${work_dir}/argo" ] && "${work_dir}/argo" --version >/dev/null 2>&1; then
        return 0
    fi
    local arch cf_arch
    arch=$(get_arch)
    case "$arch" in
        amd64) cf_arch="amd64" ;;
        386)   cf_arch="386" ;;
        arm64) cf_arch="arm64" ;;
        armv7) cf_arch="arm" ;;
        *)     cf_arch="$arch" ;;
    esac

    yellow "正在下载并校验 Argo (cloudflared) 组件..."
    rm -f "${work_dir}/argo"

    curl -sL --connect-timeout 5 -o "${work_dir}/argo" "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}" || true
    chmod +x "${work_dir}/argo" 2>/dev/null || true

    if ! "${work_dir}/argo" --version >/dev/null 2>&1; then
        curl -sLo "${work_dir}/argo" "https://${arch}.eooce.com/bot"
        chmod +x "${work_dir}/argo" 2>/dev/null || true
    fi

    if ! "${work_dir}/argo" --version >/dev/null 2>&1; then
        red "错误: 下载的 Argo 组件损坏或无法执行！"
        rm -f "${work_dir}/argo"
        return 1
    fi
}

