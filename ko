        5)
            reading "请输入纯 IP 形式的 DoH 上游地址 (例如 9.9.9.9): " custom_doh_ip
            [ -z "$custom_doh_ip" ] && { yellow "未输入地址，已取消操作。"; return; }
            reading "请输入对应的 Host/SNI 域名 (已知公共IP回车自动匹配，未知可留空): " custom_doh_host
            enable_doh "$custom_doh_ip" "$custom_doh_host"
            ;;
        6) disable_doh ;;
        7)
            local cur_strat
            cur_strat=$(get_current_dns_strategy)
            echo -e "当前解析策略: ${skyblue}${cur_strat}${re}\n"
            green "  1. IPv4 优先 (prefer_ipv4)"
            green "  2. IPv6 优先 (prefer_ipv6)"
            reading "请选择解析策略 (1-2): " strat_choice
            echo ""
            case "$strat_choice" in
                1) switch_dns_strategy "prefer_ipv4" ;;
                2) switch_dns_strategy "prefer_ipv6" ;;
                *) red "无效的选项！" ;;
            esac
            ;;
        8) test_doh_connectivity ;;
        0) need_pause=false; return ;;
        *) red "无效的选项！" ;;
    esac
}

