get_isp_name() {
    load_meta
    if [ -n "$ISP_NAME" ]; then
        format_region_label "$ISP_NAME"
        return
    fi
    local cc
    cc=$(curl -sm 3 -H "User-Agent: Mozilla/5.0" "https://api.ip.sb/geoip" | tr -d '\n' | \
        awk -F\" '{for(x=1;x<=NF;x++){if($x=="country_code"){print $(x+2); exit}}}' | \
        sed 's/[^a-zA-Z0-9_-]//g')
    if [ -z "$cc" ]; then
        cc=$(hostname 2>/dev/null | sed 's/[^a-zA-Z0-9_-]//g' || echo "Node")
    fi
    save_meta "ISP_NAME" "$cc"
    format_region_label "$cc"
}

