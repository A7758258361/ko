    fi
}

sync_argo_service() {
    if proto_exists "vmess-ws"; then
        ensure_argo_binary || return 1
        save_meta "ARGO_STOPPED" "0"
        if command_exists systemctl; then
            main_systemd_services
        elif command_exists rc-update; then
            alpine_openrc_services
        fi
        load_meta
        [ -z "$ARGO_TOKEN" ] && get_quick_tunnel
    fi
}

get_quick_tunnel() {
    load_meta
    if [ -n "$ARGO_TOKEN" ]; then
        restart_argo
        sleep 2
        return 0
    fi
    save_meta "ARGO_DOMAIN" ""
    : > "${work_dir}/argo.log" 2>/dev/null || true
    restart_argo
    yellow "正在获取 Argo 临时域名，请稍候..."
    sleep 3
    local get_argodomain=""
    if [ -f "${work_dir}/argo.log" ]; then
        for i in {1..8}; do
            get_argodomain=$(sed -n 's|.*https://\([^/]*trycloudflare\.com\).*|\1|p' "${work_dir}/argo.log" 2>/dev/null | tail -1)
            [ -n "$get_argodomain" ] && break
            sleep 2
        done
    fi
    [ -n "$get_argodomain" ] && save_meta "ARGO_DOMAIN" "$get_argodomain"
}

get_info() {
    if proto_exists "vmess-ws"; then
        get_quick_tunnel
    fi
    rebuild_urls
    clear
    green "sing-box 安装并启动成功！(BBR: $(check_bbr_status) | 自动守护: $(check_watchdog_status) | 快捷键: sb)"
    test_nodes_health
    check_nodes
}

# =========================
# 彻底卸载并恢复初始状态
# =========================
perform_full_uninstall() {
    yellow "\n正在停止服务并清理系统配置..."

    disable_watchdog >/dev/null 2>&1 || true

    if command_exists rc-service; then
        rc-service sing-box stop >/dev/null 2>&1 || true
        rc-service argo stop >/dev/null 2>&1 || true
        rc-update del sing-box default >/dev/null 2>&1 || true
        rc-update del argo default >/dev/null 2>&1 || true
        rm -f /etc/init.d/sing-box /etc/init.d/argo
    elif command_exists systemctl; then
        systemctl stop sing-box >/dev/null 2>&1 || true
        systemctl stop argo >/dev/null 2>&1 || true
        systemctl disable sing-box >/dev/null 2>&1 || true
        systemctl disable argo >/dev/null 2>&1 || true
        rm -f /etc/systemd/system/sing-box.service /etc/systemd/system/argo.service
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi

    pkill -9 -f "${work_dir}/sing-box" >/dev/null 2>&1 || true
    pkill -9 -f "${work_dir}/argo" >/dev/null 2>&1 || true

    clean_firewall_rules
    disable_bbr >/dev/null 2>&1 || true
    rm -f "$lowmem_conf" >/dev/null 2>&1 || true

    if [ -f "${work_dir}/hosts.bak" ]; then
        cp -f "${work_dir}/hosts.bak" /etc/hosts >/dev/null 2>&1 || true
    fi

    if [ -f "$swap_file" ]; then
        swapoff "$swap_file" >/dev/null 2>&1 || true
        sed -i "\|$swap_file|d" /etc/fstab 2>/dev/null || true
        rm -f "$swap_file" >/dev/null 2>&1 || true
    fi

    rm -rf "${work_dir}" >/dev/null 2>&1 || true
    rm -f /usr/bin/sb /usr/local/bin/sb /bin/sb >/dev/null 2>&1 || true

    green "\nsing-box、Argo、守护任务、BBR配置、防火墙规则及 sb 快捷指令已彻底卸载！\n"
}

uninstall_singbox() {
    clear
    red "=== 彻底卸载 sing-box 并恢复初始状态 ==="
    reading "确定要彻底卸载并恢复系统初始状态吗? (y/n): " choice
    case "${choice}" in
        y|Y) perform_full_uninstall; exit 0 ;;
        *)   purple "已取消卸载操作\n" ;;
    esac
}

