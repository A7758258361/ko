get_anytls_mode_label() {
    local inbounds_file="${conf_dir}/inbounds.json"
    if [ ! -f "$inbounds_file" ] || ! command_exists jq || ! proto_exists "anytls"; then
        echo ""
        return
    fi
    local is_reality cert_path
    is_reality=$(jq -r '.inbounds[] | select(.tag == "anytls") | .tls.reality.enabled // false' "$inbounds_file" 2>/dev/null)
    if [ "$is_reality" == "true" ]; then
        echo "Reality 强伪装"
        return
    fi
    cert_path=$(jq -r '.inbounds[] | select(.tag == "anytls") | .tls.certificate_path // empty' "$inbounds_file" 2>/dev/null)
    if [ -n "$cert_path" ] && [ "$cert_path" != "${work_dir}/cert.pem" ]; then
        echo "真实域名证书"
    else
        echo "自签证书-易被风控"
    fi
}

