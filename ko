# =========================
# 服务状态检测与管理
# =========================
get_service_file() {
    case "$1" in
        sing-box) echo "${work_dir}/${server_name}" ;;
        argo)     echo "${work_dir}/argo" ;;
        *)        echo "" ;;
    esac
}

is_service_registered() {
    local service_name="$1"
    if command_exists rc-service; then
        [ -f "/etc/init.d/${service_name}" ]
    else
        [ -f "/etc/systemd/system/${service_name}.service" ]
    fi
}

check_service_raw() {
    local service_name="$1"
    local service_file="${2:-$(get_service_file "$service_name")}"

    if [ -z "$service_file" ] || [ ! -x "$service_file" ] || ! is_service_registered "$service_name"; then
        echo "not installed"
        return 2
    fi

    if is_process_alive "$service_file" "$service_name"; then
        echo "running"; return 0
    fi

    echo "not running"
    return 1
}

check_service() {
    local st
    st=$(check_service_raw "$1" "$2")
    local ret=$?
    case "$st" in
        "running")       green "running" ;;
        "not running")   yellow "not running" ;;
        "not installed") red "not installed" ;;
    esac
    return $ret
}

check_singbox() { check_service "sing-box" "${work_dir}/${server_name}"; }
check_argo()    { check_service "argo" "${work_dir}/argo"; }

kill_service_residual() {
    local service_name="$1"
    local svc_bin
    svc_bin=$(get_service_file "$service_name")
    [ -z "$svc_bin" ] && return 0

    if is_process_alive "$svc_bin" "$service_name"; then
        pkill -x "$service_name" >/dev/null 2>&1 || pkill -f "$svc_bin" >/dev/null 2>&1 || true
        local _w=0
        while [ "$_w" -lt 10 ] && is_process_alive "$svc_bin" "$service_name"; do
            sleep 0.1
            _w=$((_w + 1))
        done
        if is_process_alive "$svc_bin" "$service_name"; then
            pkill -9 -x "$service_name" >/dev/null 2>&1 || pkill -9 -f "$svc_bin" >/dev/null 2>&1 || true
        fi
    fi
}

manage_service() {
    local service_name="$1"
    local action="$2"
    local status rc=0
    status=$(check_service_raw "$service_name")

    if [ "$action" == "start" ] || [ "$action" == "restart" ]; then
        if [ -f "${work_dir}/sb.log" ] && [ "$(wc -c < "${work_dir}/sb.log" 2>/dev/null || echo 0)" -gt 262144 ]; then
            tail -n 100 "${work_dir}/sb.log" > "${work_dir}/sb.log.tmp" 2>/dev/null && mv -f "${work_dir}/sb.log.tmp" "${work_dir}/sb.log"
        fi
    fi

    case "$action" in
        "start")
            if [ "$status" == "running" ]; then
                [ ! -f "$(get_pid_state_file "$service_name")" ] && record_service_pid "$service_name" >/dev/null 2>&1 || true
                return 0
            fi
            [ "$status" == "not installed" ] && { yellow "${service_name} 尚未安装!\n"; return 1; }
            if command_exists rc-service; then
                rc-service "$service_name" zap >/dev/null 2>&1 || true
                rc-service "$service_name" start >/dev/null 2>&1
                rc=$?
            elif command_exists systemctl; then
                systemctl daemon-reload && systemctl start "$service_name" >/dev/null 2>&1
                rc=$?
            fi
            [ "$rc" -eq 0 ] && record_service_pid "$service_name" >/dev/null 2>&1 || true
            return "$rc"
            ;;
        "stop")
            clear_service_pid "$service_name"
            [ "$status" == "not installed" ] && return 0
            if command_exists rc-service; then
                rc-service "$service_name" stop >/dev/null 2>&1 || true
                rc-service "$service_name" zap >/dev/null 2>&1 || true
            elif command_exists systemctl; then
                systemctl stop "$service_name" >/dev/null 2>&1 || true
            fi
            kill_service_residual "$service_name"
            ;;
        "restart")
            [ "$status" == "not installed" ] && { yellow "${service_name} 尚未安装！\n"; return 1; }
            if command_exists rc-service; then
                rc-service "$service_name" stop >/dev/null 2>&1 || true
                rc-service "$service_name" zap >/dev/null 2>&1 || true
                kill_service_residual "$service_name"
                rc-service "$service_name" start >/dev/null 2>&1
                rc=$?
            elif command_exists systemctl; then
                systemctl daemon-reload && systemctl restart "$service_name" >/dev/null 2>&1
                rc=$?
            fi
            [ "$rc" -eq 0 ] && record_service_pid "$service_name" >/dev/null 2>&1 || true
            return "$rc"
            ;;
    esac
}

start_singbox()   { manage_service "sing-box" "start"; }
stop_singbox()    { manage_service "sing-box" "stop"; }
restart_singbox() { manage_service "sing-box" "restart"; }
start_argo()      { manage_service "argo" "start"; }
stop_argo()       { manage_service "argo" "stop"; }
restart_argo()    { manage_service "argo" "restart"; }

# =========================
# DNS 加密管理模块 (DoH 防劫持 / 自动补全 Host 与 SNI / 恢复系统默认)
# =========================
get_doh_host_for_ip() {
    case "$1" in
        1.1.1.1|1.0.0.1|2606:4700:4700::1111|2606:4700:4700::1001)
            echo "cloudflare-dns.com" ;;
        8.8.8.8|8.8.4.4|2001:4860:4860::8888|2001:4860:4860::8844)
            echo "dns.google" ;;
        9.9.9.9|149.112.112.112|2620:fe::fe|2620:fe::9)
            echo "dns.quad9.net" ;;
        223.5.5.5|223.6.6.6|2400:3200::1|2400:3200:baba::1)
            echo "dns.alidns.com" ;;
        *)
            echo "" ;;
    esac
}

get_current_dns_strategy() {
    local dns_file="${conf_dir}/dns.json"
    local strat=""
    if [ -f "$dns_file" ] && command_exists jq; then
        strat=$(jq -r '.dns.strategy // empty' "$dns_file" 2>/dev/null)
    fi
    if [ "$strat" != "prefer_ipv4" ] && [ "$strat" != "prefer_ipv6" ] && [ "$strat" != "ipv4_only" ] && [ "$strat" != "ipv6_only" ]; then
        load_meta
        if [ "$STACK_MODE" == "v6" ]; then
            strat="prefer_ipv6"
        else
            strat="prefer_ipv4"
        fi
    fi
    echo "$strat"
}

check_dns_status() {
    local dns_file="${conf_dir}/dns.json"
    if [ "$(check_service_raw sing-box)" == "not installed" ] || [ ! -f "$dns_file" ]; then
        yellow "未安装"
        return
    fi
    if ! command_exists jq; then
        yellow "未知 (缺少 jq)"
        return
    fi
    local dtype dsrv dstrat
    dtype=$(jq -r '.dns.servers[0].type // "local"' "$dns_file" 2>/dev/null)
    dsrv=$(jq -r '.dns.servers[0].server // empty' "$dns_file" 2>/dev/null)
    dstrat=$(jq -r '.dns.strategy // "prefer_ipv4"' "$dns_file" 2>/dev/null)

    if [ "$dtype" == "https" ]; then
        green "加密 DoH (${dsrv:-unknown} | ${dstrat})"
    elif [ "$dtype" == "local" ]; then
        yellow "系统默认 local (${dstrat})"
    else
        skyblue "${dtype}${dsrv:+ (${dsrv})} | ${dstrat}"
    fi
}

is_valid_dns_ip() {
    local ip="$1"
    if printf '%s' "$ip" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        local o1 o2 o3 o4
        IFS='.' read -r o1 o2 o3 o4 <<< "$ip"
        (( 10#$o1 <= 255 && 10#$o2 <= 255 && 10#$o3 <= 255 && 10#$o4 <= 255 )) && return 0
        return 1
    elif [[ "$ip" == *":"* ]] && printf '%s' "$ip" | grep -Eq '^[0-9a-fA-F:]+$' && printf '%s' "$ip" | grep -Eq '[0-9a-fA-F]'; then
        return 0
    fi
    return 1
}

apply_dns_config() {
    local mode="$1"
    local server_ip="${2:-}"
    local strat_override="${3:-}"
    local host_override="${4:-}"
    local dns_file="${conf_dir}/dns.json"
    local tmp_file="${work_dir}/dns.json.tmp"
    local bak_file="${work_dir}/dns.json.bak"

    if [ "$(check_service_raw sing-box)" == "not installed" ]; then
        red "sing-box 尚未安装，请先选择 1 安装！"
        return 1
    fi

    local dns_strategy
    dns_strategy="${strat_override:-$(get_current_dns_strategy)}"

    local doh_host=""
    if [ "$mode" == "doh" ]; then
        server_ip=$(printf '%s' "$server_ip" | tr -d '[] \t\r\n')
        if ! is_valid_dns_ip "$server_ip"; then
            red "错误: [${server_ip}] 不是有效的纯 IPv4 或 IPv6 地址！"
            yellow "提示: 为防止被母机 53 端口劫持，DoH 上游必须使用纯 IP (例如 8.8.8.8 或 1.1.1.1)。"
            return 1
        fi
        doh_host="${host_override:-$(get_doh_host_for_ip "$server_ip")}"
    fi

    mkdir -p "$conf_dir"
    rm -f "$tmp_file" "$bak_file"
    [ -f "$dns_file" ] && cp -f "$dns_file" "$bak_file"

    if [ "$mode" == "doh" ]; then
        if [ -n "$doh_host" ]; then
            if command_exists jq; then
                jq -n --arg srv "$server_ip" --arg host "$doh_host" --arg strat "$dns_strategy" '{
                  dns: {
                    servers: [
                      {
                        tag: "local",
                        type: "https",
                        server: $srv,
                        server_port: 443,
                        path: "/dns-query",
                        headers: {
                          Host: $host
                        },
                        tls: {
                          enabled: true,
                          server_name: $host
                        }
                      }
                    ],
                    strategy: $strat
                  }
                }' > "$tmp_file"
            else
                cat > "$tmp_file" << EOF
{
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "https",
        "server": "${server_ip}",
        "server_port": 443,
        "path": "/dns-query",
        "headers": {
          "Host": "${doh_host}"
        },
        "tls": {
          "enabled": true,
          "server_name": "${doh_host}"
        }
      }
    ],
    "strategy": "${dns_strategy}"
  }
}
EOF
            fi
        else
            if command_exists jq; then
                jq -n --arg srv "$server_ip" --arg strat "$dns_strategy" '{
                  dns: {
                    servers: [
                      {
                        tag: "local",
                        type: "https",
                        server: $srv,
                        server_port: 443,
                        path: "/dns-query"
                      }
                    ],
                    strategy: $strat
                  }
                }' > "$tmp_file"
            else
                cat > "$tmp_file" << EOF
{
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "https",
        "server": "${server_ip}",
        "server_port": 443,
        "path": "/dns-query"
      }
    ],
    "strategy": "${dns_strategy}"
  }
}
EOF
            fi
        fi
    else
        if command_exists jq; then
            jq -n --arg strat "$dns_strategy" '{
              dns: {
                servers: [
                  {
                    tag: "local",
                    type: "local"
                  }
                ],
                strategy: $strat
              }
            }' > "$tmp_file"
        else
            cat > "$tmp_file" << EOF
{
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "strategy": "${dns_strategy}"
  }
}
EOF
        fi
    fi

    if [ ! -s "$tmp_file" ]; then
        red "错误: 生成 DNS 配置文件失败，未改动现有配置！"
        rm -f "$tmp_file" "$bak_file"
        return 1
    fi

    mv -f "$tmp_file" "$dns_file"

    local check_err
    if ! check_err=$("${work_dir}/${server_name}" check -C "${conf_dir}" 2>&1); then
        red "sing-box 配置校验失败，已自动回滚原 DNS 配置！"
        [ -n "$check_err" ] && yellow "错误详情: ${check_err}"
        if [ -f "$bak_file" ]; then
            mv -f "$bak_file" "$dns_file"
        else
            rm -f "$dns_file"
        fi
        return 1
    fi

    rm -f "$bak_file"
    restart_singbox
    sleep 1

    if is_process_alive "${work_dir}/${server_name}" "sing-box"; then
        if [ "$mode" == "doh" ]; then
            green "已成功开启加密 DoH (${server_ip}${doh_host:+ / ${doh_host}} | ${dns_strategy}) 并重启生效！"
        else
            green "已成功恢复系统默认 DNS (local | ${dns_strategy}) 并重启生效！"
        fi
        return 0
    else
        yellow "DNS 配置已校验通过并写入，但重启后未检测到 sing-box 存活进程，请检查 ${work_dir}/sb.log。"
        return 1
    fi
}

enable_doh() {
    local srv="${1:-8.8.8.8}"
    local custom_host="${2:-}"
    apply_dns_config "doh" "$srv" "" "$custom_host"
}

disable_doh() {
    apply_dns_config "local"
}

switch_dns_strategy() {
    local new_strat="$1"
    local dns_file="${conf_dir}/dns.json"
    if [ "$(check_service_raw sing-box)" == "not installed" ] || [ ! -f "$dns_file" ]; then
        red "sing-box 尚未安装，请先选择 1 安装！"
        return 1
    fi
    local cur_type="local" cur_srv="" cur_host=""
    if command_exists jq; then
        cur_type=$(jq -r '.dns.servers[0].type // "local"' "$dns_file" 2>/dev/null)
        cur_srv=$(jq -r '.dns.servers[0].server // empty' "$dns_file" 2>/dev/null)
        cur_host=$(jq -r '.dns.servers[0].headers.Host // .dns.servers[0].tls.server_name // empty' "$dns_file" 2>/dev/null)
    fi
    if [ "$cur_type" == "https" ] && [ -n "$cur_srv" ]; then
        apply_dns_config "doh" "$cur_srv" "$new_strat" "$cur_host"
    else
        apply_dns_config "local" "" "$new_strat"
    fi
}

test_doh_connectivity() {
    yellow "正在检测系统 DNS 与各 DoH 上游对 Cloudflare 测速接口的连通性..."
    echo ""
    local res code

    res=$(curl -sI --max-time 4 "https://speed.cloudflare.com/__down?bytes=1000" 2>&1)
    code=$(echo "$res" | awk 'NR==1 && /^HTTP\// {print $1, $2}' | tr -d '\r')
    if [ -n "$code" ]; then
        echo -e " 系统默认 DNS (53端口)       : ${green}正常 (${code})${re}"
    else
        echo -e " 系统默认 DNS (53端口)       : ${red}失败 / 可能被母机劫持${re}"
    fi

    local targets=(
        "8.8.8.8|dns.google|Google DoH (IPv4)    "
        "1.1.1.1|cloudflare-dns.com|Cloudflare DoH (IPv4)"
        "2001:4860:4860::8888|dns.google|Google DoH (IPv6)    "
        "2606:4700:4700::1111|cloudflare-dns.com|Cloudflare DoH (IPv6)"
    )
    local entry ip host label
    for entry in "${targets[@]}"; do
        ip="${entry%%|*}"
        local rest="${entry#*|}"
        host="${rest%%|*}"
        label="${rest#*|}"
        res=$(curl -sI --max-time 4 --resolve "${host}:443:${ip}" --doh-url "https://${host}/dns-query" "https://speed.cloudflare.com/__down?bytes=1000" 2>&1)
        code=$(echo "$res" | awk 'NR==1 && /^HTTP\// {print $1, $2}' | tr -d '\r')
        if [ -n "$code" ]; then
            echo -e " ${label} : ${green}可用 (${code})${re}"
        else
            echo -e " ${label} : ${yellow}不可达 / 超时${re}"
        fi
    done
    echo ""
}

