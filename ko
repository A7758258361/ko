    argo_status=$(check_argo 2>/dev/null)
    bbr_status=$(check_bbr_status 2>/dev/null)
    wd_status=$(check_watchdog_status 2>/dev/null)
    dns_status=$(check_dns_status 2>/dev/null)

    clear; echo ""
    purple "=== sing-box 64M极简管理面板 (快捷键: sb) ==="
    echo ""
    purple "sing-box: ${singbox_status}  |  Argo: ${argo_status}"
    purple "BBR: ${bbr_status}  |  自动守护: ${wd_status}"
    purple "DNS: ${dns_status}"
