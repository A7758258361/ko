    priv_key="YFYOAdbw1bKTHlNNi+aEjBM3BO7unuFC5rOkMRAz9XY="
    v4_addr="172.16.0.2/32"
    v6_addr="2606:4700:110:8dfe:d141:69bb:6b80:925/128"
    res_array="[78, 135, 76]"

    if [ -x "${work_dir}/${server_name}" ]; then
        wg_out=$("${work_dir}/${server_name}" generate wg-keypair 2>/dev/null || true)
        local gen_priv gen_pub
        gen_priv=$(echo "$wg_out" | awk '/PrivateKey:/ {print $2}')
        gen_pub=$(echo "$wg_out" | awk '/PublicKey:/ {print $2}')

        if [ -n "$gen_priv" ] && [ -n "$gen_pub" ]; then
            reg_json=$(curl -sm 5 -X POST "https://api.cloudflareclient.com/v0a2158/reg" \
                -H "Content-Type: application/json" \
                -d "{\"key\":\"${gen_pub}\",\"install_id\":\"\",\"warp_enabled\":true,\"tos\":\"$(date -u +%Y-%m-%dT%H:%M:%S.000Z)\",\"type\":\"Android\",\"locale\":\"en_US\"}" 2>/dev/null || true)

            local api_v4 api_v6
            api_v4=$(echo "$reg_json" | jq -r '.config.interface.addresses.v4 // empty' 2>/dev/null)
            api_v6=$(echo "$reg_json" | jq -r '.config.interface.addresses.v6 // empty' 2>/dev/null)
            client_id=$(echo "$reg_json" | jq -r '.config.client_id // empty' 2>/dev/null)

            if [ -n "$api_v4" ] && [ -n "$api_v6" ]; then
                priv_key="$gen_priv"
                v4_addr="${api_v4}/32"
                v6_addr="${api_v6}/128"
                reg_ok=1
                if [ -n "$client_id" ] && command_exists od; then
                    local b1 b2 b3
                    read -r b1 b2 b3 <<< "$(printf '%s' "$client_id" | base64 -d 2>/dev/null | od -An -tu1 -N3 2>/dev/null)"
                    if [[ "$b1" =~ ^[0-9]+$ ]] && [[ "$b2" =~ ^[0-9]+$ ]] && [[ "$b3" =~ ^[0-9]+$ ]]; then
                        res_array="[${b1}, ${b2}, ${b3}]"
                    fi
                fi
            fi
        fi
    fi

    [ "$reg_ok" -eq 0 ] && yellow "提示: Cloudflare WARP API 注册超时，已使用备用 WARP 密钥配置。"

    cat > "$ep_file" << EOF
{
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "wireguard-out",
      "mtu": 1280,
      "address": [
        "${v4_addr}",
        "${v6_addr}"
      ],
      "private_key": "${priv_key}",
      "peers": [
        {
          "address": "engage.cloudflareclient.com",
          "port": 2408,
          "public_key": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
          "allowed_ips": ["0.0.0.0/0", "::/0"],
          "reserved": ${res_array}
        }
      ]
    }
  ]
}
EOF
}

# =========================
# 协议管理底层逻辑
# =========================
proto_exists() {
    local tag="$1"
    [ -f "${conf_dir}/inbounds.json" ] && jq -e --arg tag "$tag" '.inbounds[] | select(.tag == $tag)' "${conf_dir}/inbounds.json" >/dev/null 2>&1
}

add_proto_to_inbounds() {
    local proto_key="$1"
    local interactive="${2:-1}"
    local inbounds_file="${conf_dir}/inbounds.json"
    load_meta
    local listen_ip="${LISTEN_IP:-::}"

    case "$proto_key" in
        vless|vless-reality)
            if proto_exists "vless-reality"; then
                yellow "vless-reality 已存在，跳过添加。"; return 0
            fi
            local def_port="${VLESS_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "VLESS-Reality (TCP)" "$def_port" "vless-reality" "tcp"
                def_port="$Selected_Port"
            fi
            save_meta "VLESS_PORT" "$def_port"
            local sni="${REALITY_SNI:-www.iij.ad.jp}"
            save_meta "REALITY_SNI" "$sni"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg uuid "$UUID" \
               --arg sni "$sni" \
               --arg pk "$PRIVATE_KEY" \
               '.inbounds += [{
                   "type": "vless",
                   "tag": "vless-reality",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"uuid": $uuid, "flow": "xtls-rprx-vision"}],
                   "tls": {
                       "enabled": true,
                       "server_name": $sni,
                       "reality": {
                           "enabled": true,
                           "handshake": {"server": $sni, "server_port": 443},
                           "private_key": $pk,
                           "short_id": [""]
                       }
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp"
            ;;

        vmess|vmess-ws)
            if proto_exists "vmess-ws"; then
                yellow "vmess-ws 已存在，跳过添加。"; return 0
            fi
            ensure_argo_binary || return 1
            local def_port="${VMESS_PORT:-8001}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "VMess-WS (Argo本地回环监听)" "$def_port" "vmess-ws" "local"
                def_port="$Selected_Port"
            fi
            save_meta "VMESS_PORT" "$def_port"
            save_meta "ARGO_STOPPED" "0"

            jq --argjson port "$def_port" \
               --arg uuid "$UUID" \
               '.inbounds += [{
                   "type": "vmess",
                   "tag": "vmess-ws",
                   "listen": "127.0.0.1",
                   "listen_port": $port,
                   "users": [{"uuid": $uuid}],
                   "transport": {
                       "type": "ws",
                       "path": "/vmess-argo",
                       "early_data_header_name": "Sec-WebSocket-Protocol"
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            ;;

        hy2|hysteria2)
            if proto_exists "hysteria2"; then
                yellow "hysteria2 已存在，跳过添加。"; return 0
            fi
            local def_port="${HY2_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "Hysteria2 (UDP)" "$def_port" "hysteria2" "udp"
                def_port="$Selected_Port"
            fi
            save_meta "HY2_PORT" "$def_port"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg uuid "$UUID" \
               --arg cert "${work_dir}/cert.pem" \
               --arg key "${work_dir}/private.key" \
               '.inbounds += [{
                   "type": "hysteria2",
                   "tag": "hysteria2",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"password": $uuid}],
                   "ignore_client_bandwidth": false,
                   "masquerade": "https://bing.com",
                   "tls": {
                       "enabled": true,
                       "alpn": ["h3"],
                       "min_version": "1.3",
                       "max_version": "1.3",
                       "certificate_path": $cert,
                       "key_path": $key
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/udp"
            ;;

        tuic|tuic5)
            if proto_exists "tuic"; then
                yellow "tuic 已存在，跳过添加。"; return 0
            fi
            local def_port="${TUIC_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "TUIC-v5 (UDP)" "$def_port" "tuic" "udp"
                def_port="$Selected_Port"
            fi
            save_meta "TUIC_PORT" "$def_port"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg uuid "$UUID" \
               --arg cert "${work_dir}/cert.pem" \
               --arg key "${work_dir}/private.key" \
               '.inbounds += [{
                   "type": "tuic",
                   "tag": "tuic",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"uuid": $uuid, "password": $uuid}],
                   "congestion_control": "bbr",
                   "tls": {
                       "enabled": true,
                       "alpn": ["h3"],
                       "certificate_path": $cert,
                       "key_path": $key
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/udp"
            ;;

        anytls)
            if proto_exists "anytls"; then
                yellow "AnyTLS 已存在，跳过添加。"; return 0
            fi
            local def_port="${ANYTLS_PORT:-$(rand_port)}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "AnyTLS (TCP)" "$def_port" "anytls" "tcp"
                def_port="$Selected_Port"
            fi
            save_meta "ANYTLS_PORT" "$def_port"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg pass "$UUID" \
               --arg cert "${work_dir}/cert.pem" \
               --arg key "${work_dir}/private.key" \
               '.inbounds += [{
                   "type": "anytls",
                   "tag": "anytls",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"password": $pass}],
                   "tls": {
                       "enabled": true,
                       "certificate_path": $cert,
                       "key_path": $key
                   }
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp"
            ;;

        socks|socks5|socks5-in)
            if proto_exists "socks5-in"; then
                yellow "Socks5 已存在，跳过添加。"; return 0
            fi
            local def_port="${SOCKS_PORT:-$(rand_port)}"
            local sk_user="${SOCKS_USER:-${UUID:0:8}}"
            local sk_pass="${SOCKS_PASS:-${UUID: -12}}"
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "Socks5 (TCP+UDP)" "$def_port" "socks5-in" "both"
                def_port="$Selected_Port"
                reading "请输入 Socks5 用户名 (直接回车默认 ${sk_user}): " input_u
                [ -n "$input_u" ] && sk_user="$input_u"
                reading "请输入 Socks5 密码 (直接回车默认 ${sk_pass}): " input_pw
                [ -n "$input_pw" ] && sk_pass="$input_pw"
            fi
            save_meta "SOCKS_PORT" "$def_port"
            save_meta "SOCKS_USER" "$sk_user"
            save_meta "SOCKS_PASS" "$sk_pass"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg user "$sk_user" \
               --arg pass "$sk_pass" \
               '.inbounds += [{
                   "type": "socks",
                   "tag": "socks5-in",
                   "listen": $listen,
                   "listen_port": $port,
                   "users": [{"username": $user, "password": $pass}]
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp" "${def_port}/udp"
            ;;

        ss|ss2022|shadowsocks-2022)
            if proto_exists "shadowsocks-2022"; then
                yellow "Shadowsocks-2022 已存在，跳过添加。"; return 0
            fi
            local def_port="${SS_PORT:-$(rand_port)}"
            local ss_method="${SS_METHOD:-2022-blake3-aes-128-gcm}"
            local key_len=16
            if [ "$interactive" -eq 1 ]; then
                prompt_custom_port "Shadowsocks-2022 (TCP+UDP)" "$def_port" "shadowsocks-2022" "both"
                def_port="$Selected_Port"
                green "请选择 SS2022 加密方式: 1. aes-128-gcm(默认)  2. aes-256-gcm  3. chacha20-poly1305"
                reading "请输入选择 (回车默认1): " m_choice
                case "$m_choice" in
                    2) ss_method="2022-blake3-aes-256-gcm"; key_len=32 ;;
                    3) ss_method="2022-blake3-chacha20-poly1305"; key_len=32 ;;
                    *) ss_method="2022-blake3-aes-128-gcm"; key_len=16 ;;
                esac
            fi
            local ss_key
            ss_key=$(dd if=/dev/urandom bs=1 count=${key_len} 2>/dev/null | b64_encode)
            save_meta "SS_PORT" "$def_port"
            save_meta "SS_METHOD" "$ss_method"
            save_meta "SS_KEY" "$ss_key"

            jq --arg listen "$listen_ip" \
               --argjson port "$def_port" \
               --arg method "$ss_method" \
               --arg key "$ss_key" \
               '.inbounds += [{
                   "type": "shadowsocks",
                   "tag": "shadowsocks-2022",
                   "listen": $listen,
                   "listen_port": $port,
                   "method": $method,
                   "password": $key,
                   "multiplex": {"enabled": true}
               }]' "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"
            allow_port "${def_port}/tcp" "${def_port}/udp"
            ;;
    esac
}

remove_proto_from_inbounds() {
    local tag="$1"
    local inbounds_file="${conf_dir}/inbounds.json"
    if ! proto_exists "$tag"; then
        yellow "协议 [$tag] 当前未启用，无需删除。"
        return 1
    fi

    local old_port
    old_port=$(jq -r --arg tag "$tag" '.inbounds[] | select(.tag == $tag) | .listen_port' "$inbounds_file")

    jq --arg tag "$tag" 'del(.inbounds[] | select(.tag == $tag))' \
        "$inbounds_file" > "${inbounds_file}.tmp" && mv "${inbounds_file}.tmp" "$inbounds_file"

    case "$tag" in
        vless-reality|anytls) [ -n "$old_port" ] && revoke_port "${old_port}/tcp" ;;
        hysteria2)
            [ -n "$old_port" ] && revoke_port "${old_port}/udp"
            clean_hy2_mport_rules
            save_meta "HY2_MPORT_MIN" ""
            save_meta "HY2_MPORT_MAX" ""
            save_meta "HY2_MPORT_TARGET" ""
            ;;
        tuic) [ -n "$old_port" ] && revoke_port "${old_port}/udp" ;;
        socks5-in|shadowsocks-2022) [ -n "$old_port" ] && revoke_port "${old_port}/tcp" "${old_port}/udp" ;;
        vmess-ws)
            save_meta "ARGO_STOPPED" "0"
            stop_argo
            if command_exists systemctl; then
                systemctl disable argo >/dev/null 2>&1 || true
            elif command_exists rc-update; then
                rc-update del argo default >/dev/null 2>&1 || true
            fi
            yellow "已同步停止 Argo 进程释放内存。"
            ;;
    esac
    return 0
}

# =========================
# 生成节点列表并输出纯 Base64 编码
# =========================
rebuild_urls() {
    local inbounds_file="${conf_dir}/inbounds.json"
    [ ! -f "$inbounds_file" ] && return 1

    sync_latest_argo_domain || true
    load_meta
    local isp
    isp=$(get_isp_name)
    local cfip="${CFIP_SAVED:-${CFIP}}"
    local cfport="${CFPORT_SAVED:-${CFPORT}}"

    local addr_list=()
    local suffix_list=()
    case "${STACK_MODE}" in
        v4)
            local v4="${NODE_IPV4:-$(detect_ipv4)}"
            addr_list=("${v4:-127.0.0.1}")
            suffix_list=("")
            ;;
        v6)
            local v6="${NODE_IPV6:-$(detect_ipv6)}"
            v6=$(echo "$v6" | tr -d '[]')
            addr_list=("[${v6:-::1}]")
            suffix_list=("")
            ;;
        dual)
            local v4="${NODE_IPV4:-$(detect_ipv4)}"
            local v6="${NODE_IPV6:-$(detect_ipv6)}"
            v6=$(echo "$v6" | tr -d '[]')
            [ -n "$v4" ] && { addr_list+=("$v4"); suffix_list+=("-v4"); }
            [ -n "$v6" ] && { addr_list+=("[${v6}]"); suffix_list+=("-v6"); }
            if [ "${#addr_list[@]}" -eq 0 ]; then
                addr_list=("127.0.0.1"); suffix_list=("")
            fi
            ;;
        *)
            local cip="${CUSTOM_NODE_IP:-$(detect_ipv4)}"
            addr_list=("${cip:-127.0.0.1}")
            suffix_list=("")
            ;;
    esac

    > "$client_dir"

    if proto_exists "vless-reality"; then
        local v_port v_uuid v_sni
        v_port=$(jq -r '.inbounds[] | select(.tag == "vless-reality") | .listen_port' "$inbounds_file")
        v_uuid=$(jq -r '.inbounds[] | select(.tag == "vless-reality") | .users[0].uuid' "$inbounds_file")
        v_sni=$(jq -r '.inbounds[] | select(.tag == "vless-reality") | .tls.server_name' "$inbounds_file")
        for idx in "${!addr_list[@]}"; do
            echo "vless://${v_uuid}@${addr_list[$idx]}:${v_port}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${v_sni}&fp=firefox&pbk=${PUBLIC_KEY}&type=tcp&headerType=none#${isp}${suffix_list[$idx]}-vless-reality" >> "$client_dir"
        done
    fi

    if proto_exists "vmess-ws"; then
        local m_uuid argodomain
        m_uuid=$(jq -r '.inbounds[] | select(.tag == "vmess-ws") | .users[0].uuid' "$inbounds_file")
        argodomain="${ARGO_DOMAIN}"
        # 若为临时隧道模式，始终优先从 argo.log 提取最新生成的 trycloudflare 域名
        if [ -z "$ARGO_TOKEN" ] && [ -f "${work_dir}/argo.log" ]; then
            local latest_log_dom
            latest_log_dom=$(sed -n 's|.*https://\([^/]*trycloudflare\.com\).*|\1|p' "${work_dir}/argo.log" 2>/dev/null | tail -1)
            [ -n "$latest_log_dom" ] && argodomain="$latest_log_dom"
        fi
        [ -z "$argodomain" ] && argodomain="argo-pending.trycloudflare.com"
        save_meta "ARGO_DOMAIN" "$argodomain"

        local vmess_json
        vmess_json=$(jq -cn \
            --arg ps "${isp}-argo-vmess-ws" \
            --arg add "$cfip" \
            --arg port "$cfport" \
            --arg id "$m_uuid" \
            --arg host "$argodomain" \
            '{v:"2", ps:$ps, add:$add, port:$port, id:$id, aid:"0", scy:"auto", net:"ws", type:"none", host:$host, path:"/vmess-argo?ed=2560", tls:"tls", sni:$host, alpn:"", fp:"firefox", allowInsecure:"false"}')
        echo "vmess://$(printf '%s' "$vmess_json" | b64_encode)" >> "$client_dir"
    fi

    if proto_exists "hysteria2"; then
        local h_port h_pass mport_str=""
        h_port=$(jq -r '.inbounds[] | select(.tag == "hysteria2") | .listen_port' "$inbounds_file")
        h_pass=$(jq -r '.inbounds[] | select(.tag == "hysteria2") | .users[0].password' "$inbounds_file")
        if [ -n "$HY2_MPORT_MIN" ] && [ -n "$HY2_MPORT_MAX" ]; then
            mport_str="&mport=${h_port},${HY2_MPORT_MIN}-${HY2_MPORT_MAX}"
        fi
        for idx in "${!addr_list[@]}"; do
            echo "hysteria2://${h_pass}@${addr_list[$idx]}:${h_port}/?sni=www.bing.com&insecure=1&pinSHA256=${FINGERPRINT}&alpn=h3&obfs=none${mport_str}#${isp}${suffix_list[$idx]}-hysteria2" >> "$client_dir"
        done
    fi

    if proto_exists "tuic"; then
        local t_port t_uuid t_pass
        t_port=$(jq -r '.inbounds[] | select(.tag == "tuic") | .listen_port' "$inbounds_file")
        t_uuid=$(jq -r '.inbounds[] | select(.tag == "tuic") | .users[0].uuid' "$inbounds_file")
        t_pass=$(jq -r '.inbounds[] | select(.tag == "tuic") | .users[0].password' "$inbounds_file")
        for idx in "${!addr_list[@]}"; do
            echo "tuic://${t_uuid}:${t_pass}@${addr_list[$idx]}:${t_port}?sni=www.bing.com&congestion_control=bbr&udp_relay_mode=native&alpn=h3&allow_insecure=1#${isp}${suffix_list[$idx]}-tuic5" >> "$client_dir"
        done
    fi

    if proto_exists "anytls"; then
        local a_port a_pass
        a_port=$(jq -r '.inbounds[] | select(.tag == "anytls") | .listen_port' "$inbounds_file")
        a_pass=$(jq -r '.inbounds[] | select(.tag == "anytls") | .users[0].password' "$inbounds_file")
        for idx in "${!addr_list[@]}"; do
            echo "anytls://${a_pass}@${addr_list[$idx]}:${a_port}?insecure=1&sni=bing.com#${isp}${suffix_list[$idx]}-anytls" >> "$client_dir"
        done
    fi

    if proto_exists "socks5-in"; then
        local s_port s_user s_pass s_auth
        s_port=$(jq -r '.inbounds[] | select(.tag == "socks5-in") | .listen_port' "$inbounds_file")
        s_user=$(jq -r '.inbounds[] | select(.tag == "socks5-in") | .users[0].username' "$inbounds_file")
        s_pass=$(jq -r '.inbounds[] | select(.tag == "socks5-in") | .users[0].password' "$inbounds_file")
        s_auth=$(printf '%s:%s' "$s_user" "$s_pass" | b64_encode)
        for idx in "${!addr_list[@]}"; do
            echo "socks://${s_auth}@${addr_list[$idx]}:${s_port}#${isp}${suffix_list[$idx]}-socks5" >> "$client_dir"
        done
    fi

    if proto_exists "shadowsocks-2022"; then
        local ss_port ss_method ss_key ss_auth
        ss_port=$(jq -r '.inbounds[] | select(.tag == "shadowsocks-2022") | .listen_port' "$inbounds_file")
        ss_method=$(jq -r '.inbounds[] | select(.tag == "shadowsocks-2022") | .method' "$inbounds_file")
        ss_key=$(jq -r '.inbounds[] | select(.tag == "shadowsocks-2022") | .password' "$inbounds_file")
        ss_auth=$(printf '%s:%s' "$ss_method" "$ss_key" | b64_encode)
        for idx in "${!addr_list[@]}"; do
            echo "ss://${ss_auth}@${addr_list[$idx]}:${ss_port}#${isp}${suffix_list[$idx]}-ss2022" >> "$client_dir"
        done
    fi

    if [ -s "$client_dir" ]; then
        b64_encode < "$client_dir" > "$sub_file"
    else
        > "$sub_file"
    fi
}

check_nodes() {
    # 查看节点前自动检查 Argo 临时域名是否在后台重启后发生变更
    if proto_exists "vmess-ws" && sync_latest_argo_domain; then
        rebuild_urls >/dev/null 2>&1 || true
    fi
    if [ ! -f "${sub_file}" ] || [ ! -s "${sub_file}" ]; then
        red "\n当前没有已生成的节点 Base64 数据，请先安装或添加协议。\n"
        return 1
    fi
    echo ""
    green "==================== 节点 Base64 编码 ===================="
    echo ""
    echo -e "${purple}$(cat "${sub_file}")${re}"
    echo ""
    green "=========================================================="
    echo ""
}

