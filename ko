#!/bin/sh

# ==========================================================
# 前置 Root 权限校验与自释放层 (兼容 Alpine / Debian 及任意运行方式)
# ==========================================================
if [ "$(id -u)" -ne 0 ]; then
    echo "请在 root 用户下运行脚本 (输入 sudo -i 切换)"
    exit 1
fi

mkdir -p /etc/sing-box

if [ "$0" != "/etc/sing-box/sb.sh" ] && [ "$0" != "/usr/bin/sb" ] && [ "$0" != "/bin/sb" ] && [ "$0" != "/usr/local/bin/sb" ]; then
    cat > /etc/sing-box/sb.sh << '===SB_MAIN_SCRIPT_EOF==='
#!/usr/bin/env bash

# =========================
# sing-box 64M极简低内存多协议脚本 (AnyTLS-Reality抗探测 + 双层守护全记录 + DoH防劫持 + 自检测速版)
# 支持协议: vless-reality | vmess-ws(argo) | hysteria2 | tuic5 | anytls(reality/cert) | socks5 | ss2022
# =========================

export LANG=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# 定义颜色
re="\033[0m"
red="\033[1;91m"
green="\e[1;32m"
yellow="\e[1;33m"
purple="\e[1;35m"
skyblue="\e[1;36m"
red() { echo -e "\e[1;91m$1\033[0m"; }
green() { echo -e "\e[1;32m$1\e[0m"; }
yellow() { echo -e "\e[1;33m$1\e[0m"; }
purple() { echo -e "\e[1;35m$1\e[0m"; }
skyblue() { echo -e "\e[1;36m$1\e[0m"; }
reading() { read -p "$(red "$1")" "$2"; }

# 定义路径常量
server_name="sing-box"
work_dir="/etc/sing-box"
conf_dir="${work_dir}/conf"
client_dir="${work_dir}/url.txt"
sub_file="${work_dir}/sub.txt"
meta_file="${work_dir}/meta.conf"
ports_file="${work_dir}/ports.list"
watchdog_log="${work_dir}/watchdog.log"
swap_file="/swapfile_sb"
bbr_conf="/etc/sysctl.d/99-sb-bbr.conf"
lowmem_conf="/etc/sysctl.d/99-sb-lowmem.conf"

export CFIP=${CFIP:-'cdns.doon.eu.org'}
export CFPORT=${CFPORT:-'443'}

[[ $EUID -ne 0 ]] && red "请在 root 用户下运行脚本 (输入 sudo -i 切换)" && exit 1

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# 兼容 Alpine(BusyBox) 与 Debian 的 Base64 不换行编码
b64_encode() {
    base64 -w0 2>/dev/null || base64 | tr -d '\n\r'
}

# 随机端口生成
rand_port() {
    shuf -i 10000-60000 -n 1 2>/dev/null || echo $(( (RANDOM % 50000) + 10000 ))
}

# 生成 8 位十六进制 Reality Short ID
rand_hex8() {
    openssl rand -hex 4 2>/dev/null || head -c 4 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n' || echo "a1b2c3d4"
}

# 确保 sb 软链接始终存在
ensure_sb_links() {
    chmod +x "${work_dir}/sb.sh" 2>/dev/null || true
    ln -sf "${work_dir}/sb.sh" /usr/bin/sb 2>/dev/null || true
    ln -sf "${work_dir}/sb.sh" /usr/local/bin/sb 2>/dev/null || true
    ln -sf "${work_dir}/sb.sh" /bin/sb 2>/dev/null || true
}
ensure_sb_links

# =========================
# 元数据持久化安全读写
# =========================
save_meta() {
    local key="$1"
    local val="$2"
    mkdir -p "$work_dir"
    touch "$meta_file"
    chmod 600 "$meta_file" 2>/dev/null || true
    local tmp_meta="${meta_file}.tmp"
    grep -v "^${key}=" "$meta_file" > "$tmp_meta" 2>/dev/null || true
    printf '%s=%q\n' "$key" "$val" >> "$tmp_meta"
    mv -f "$tmp_meta" "$meta_file"
}

load_meta() {
    [ -f "$meta_file" ] && source "$meta_file"
}

# 确保 Reality 密钥对存在
ensure_reality_keypair() {
    load_meta
    if [ -z "$PRIVATE_KEY" ] || [ -z "$PUBLIC_KEY" ]; then
        if [ ! -x "${work_dir}/${server_name}" ]; then
            red "错误: 未找到 sing-box 主程序，无法生成 Reality 密钥对！"
            return 1
        fi
        local kp_out
        kp_out=$("${work_dir}/${server_name}" generate reality-keypair 2>/dev/null)
        PRIVATE_KEY=$(echo "$kp_out" | awk '/PrivateKey:/ {print $2}')
        PUBLIC_KEY=$(echo "$kp_out" | awk '/PublicKey:/ {print $2}')
        if [ -z "$PRIVATE_KEY" ] || [ -z "$PUBLIC_KEY" ]; then
            red "错误: 生成 Reality 密钥对失败！"
            return 1
        fi
        save_meta "PRIVATE_KEY" "$PRIVATE_KEY"
        save_meta "PUBLIC_KEY" "$PUBLIC_KEY"
    fi
    return 0
}

# 实时从 argo.log 提取最新临时域名并同步至 meta.conf
sync_latest_argo_domain() {
    load_meta
    if [ -z "$ARGO_TOKEN" ] && [ -f "${work_dir}/argo.log" ]; then
        local latest_dom
        latest_dom=$(sed -n 's|.*https://\([^/]*trycloudflare\.com\).*|\1|p' "${work_dir}/argo.log" 2>/dev/null | tail -1)
        if [ -n "$latest_dom" ] && [ "$latest_dom" != "$ARGO_DOMAIN" ]; then
            save_meta "ARGO_DOMAIN" "$latest_dom"
            ARGO_DOMAIN="$latest_dom"
            return 0
        fi
    fi
    return 1
}

# =========================
# BBR 加速管理模块
# =========================
check_bbr_status() {
    local cc qdisc
    cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo "unknown")
    qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null || cat /proc/sys/net/core/default_qdisc 2>/dev/null || echo "unknown")
    if [ "$cc" = "bbr" ]; then
        green "已开启 (${cc}+${qdisc})"
    else
        yellow "未开启 (当前: ${cc})"
    fi
}

enable_bbr() {
    yellow "正在开启 BBR 加速通道..."
    modprobe tcp_bbr >/dev/null 2>&1 || true
    modprobe sch_fq >/dev/null 2>&1 || true

    mkdir -p /etc/sysctl.d >/dev/null 2>&1 || true
    cat > "$bbr_conf" 2>/dev/null << 'EOF' || true
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF

    if [ -f /etc/sysctl.conf ]; then
        sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf 2>/dev/null || true
        sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf 2>/dev/null || true
        echo "net.core.default_qdisc = fq" >> /etc/sysctl.conf 2>/dev/null || true
        echo "net.ipv4.tcp_congestion_control = bbr" >> /etc/sysctl.conf 2>/dev/null || true
    fi

    sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1 || true
    sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1 || true
    sysctl -p "$bbr_conf" >/dev/null 2>&1 || sysctl -p >/dev/null 2>&1 || true

    local current_cc
    current_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)
    if [ "$current_cc" = "bbr" ]; then
        green "BBR 加速通道已成功开启！"
    else
        yellow "提示: 当前虚拟化容器内核不支持直接挂载 BBR (当前为: ${current_cc:-默认})，已自动跳过。"
    fi
}

disable_bbr() {
    yellow "正在关闭 BBR 加速通道并恢复默认拥塞控制..."
    rm -f "$bbr_conf" >/dev/null 2>&1 || true
    if [ -f /etc/sysctl.conf ]; then
        sed -i '/net.core.default_qdisc/d' /etc/sysctl.conf 2>/dev/null || true
        sed -i '/net.ipv4.tcp_congestion_control/d' /etc/sysctl.conf 2>/dev/null || true
    fi

    sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1 || true
    sysctl -w net.core.default_qdisc=pfifo_fast >/dev/null 2>&1 || sysctl -w net.core.default_qdisc=fq_codel >/dev/null 2>&1 || true
    sysctl -p >/dev/null 2>&1 || true

    local current_cc
    current_cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)
    green "BBR 加速已关闭！(当前拥塞控制已恢复为: ${purple}${current_cc:-cubic}${re})"
}

manage_bbr_menu() {
    clear; echo ""
    green "=== BBR 加速通道管理 ==="
    echo -e "\n当前 BBR 状态: $(check_bbr_status)\n"
    green "1. 开启 BBR 加速 (bbr + fq)"
    skyblue "----------------------------------------"
    red   "2. 关闭 BBR 加速 (恢复默认 cubic)"
    skyblue "----------------------------------------"
    purple "0. 返回主菜单"
    skyblue "----------------------------------------"
    reading "请输入选择: " bbr_choice
    echo ""
    case "$bbr_choice" in
        1) enable_bbr ;;
        2) disable_bbr ;;
        0) need_pause=false; return ;;
        *) red "无效的选项！" ;;
    esac
}

# =========================
# 64M 内存防崩溃与内核网络缓冲区优化 (支持重启持久化)
# =========================
get_sb_mem_limit() {
    local mem_total
    mem_total=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 128)
    if [ "$mem_total" -le 96 ]; then
        echo "18MiB"
    else
        echo "25MiB"
    fi
}

optimize_low_memory() {
    local mem_total swap_total free_disk_mb
    mem_total=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 256)
    swap_total=$(awk '/SwapTotal/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)
    free_disk_mb=$(df -Pm / 2>/dev/null | awk 'NR==2 {print int($4)}' || echo 0)

    mkdir -p /etc/sysctl.d >/dev/null 2>&1 || true
    cat > "$lowmem_conf" 2>/dev/null << 'EOF' || true
net.ipv6.bindv6only = 0
vm.overcommit_memory = 1
vm.vfs_cache_pressure = 200
EOF

    sysctl -w net.ipv6.bindv6only=0 >/dev/null 2>&1 || true
    sysctl -w vm.overcommit_memory=1 >/dev/null 2>&1 || true
    sysctl -w vm.vfs_cache_pressure=200 >/dev/null 2>&1 || true

    if [ "$mem_total" -le 128 ]; then
        cat >> "$lowmem_conf" 2>/dev/null << 'EOF' || true
net.core.rmem_max = 262144
net.core.wmem_max = 262144
net.ipv4.tcp_rmem = 4096 32768 262144
net.ipv4.tcp_wmem = 4096 32768 262144
EOF
        sysctl -w net.core.rmem_max=262144 >/dev/null 2>&1 || true
        sysctl -w net.core.wmem_max=262144 >/dev/null 2>&1 || true
        sysctl -w net.ipv4.tcp_rmem="4096 32768 262144" >/dev/null 2>&1 || true
        sysctl -w net.ipv4.tcp_wmem="4096 32768 262144" >/dev/null 2>&1 || true
    fi
    sysctl -p "$lowmem_conf" >/dev/null 2>&1 || true

    if [ "$mem_total" -le 192 ] && [ "$swap_total" -lt 64 ]; then
        if [ "$free_disk_mb" -lt 200 ]; then
            yellow "检测到可用磁盘空间不足 (${free_disk_mb}MB < 200MB)，跳过创建 Swap，已启用低内存缓冲区与 GOMEMLIMIT 保护。"
            return 0
        fi
        yellow "检测到物理内存较小 (${mem_total}MB)，尝试创建 128MB Swap 防崩溃..."
        if [ ! -f "$swap_file" ]; then
            dd if=/dev/zero of="$swap_file" bs=1M count=128 status=none 2>/dev/null || true
            chmod 600 "$swap_file" 2>/dev/null || true
            mkswap "$swap_file" >/dev/null 2>&1 || true
            if swapon "$swap_file" >/dev/null 2>&1; then
                sysctl -w vm.swappiness=60 >/dev/null 2>&1 || true
                grep -q "$swap_file" /etc/fstab 2>/dev/null || echo "$swap_file swap swap defaults 0 0" >> /etc/fstab
                green "128MB Swap 启用成功！"
            else
                rm -f "$swap_file" >/dev/null 2>&1 || true
                yellow "当前容器不支持挂载 Swap，已通过 GOMEMLIMIT=$(get_sb_mem_limit) 与内核网络缓冲区限制保障稳定运行。"
            fi
        fi
    fi
}

# =========================
# 断联自动重启守护 (看门狗模块 + 第一层秒级重启 PID 追踪，零常驻内存)
# =========================
check_watchdog_raw() {
    if crontab -l 2>/dev/null | grep -q "/usr/bin/sb -w"; then
        echo "enabled"
        return 0
    elif [ -f /etc/crontabs/root ] && grep -q "/usr/bin/sb -w" /etc/crontabs/root 2>/dev/null; then
        echo "enabled"
        return 0
    else
        echo "disabled"
        return 1
    fi
}

check_watchdog_status() {
    if [ "$(check_watchdog_raw)" = "enabled" ]; then
        green "已开启 (秒级守护+每分钟巡检)"
    else
        yellow "未开启"
    fi
}

enable_watchdog() {
    mkdir -p "$work_dir"
    local cron_job="* * * * * /usr/bin/sb -w >/dev/null 2>&1"

    if command_exists crontab; then
        (crontab -l 2>/dev/null | grep -v "/usr/bin/sb -w"; echo "$cron_job") | crontab - 2>/dev/null || true
    elif [ -d /etc/crontabs ]; then
        touch /etc/crontabs/root
        grep -v "/usr/bin/sb -w" /etc/crontabs/root > /etc/crontabs/root.tmp 2>/dev/null || true
        echo "$cron_job" >> /etc/crontabs/root.tmp
        mv -f /etc/crontabs/root.tmp /etc/crontabs/root
    fi

    if command_exists rc-service; then
        rc-update add crond default >/dev/null 2>&1 || true
        rc-service crond start >/dev/null 2>&1 || true
    elif command_exists systemctl; then
        systemctl enable cron >/dev/null 2>&1 || systemctl enable crond >/dev/null 2>&1 || true
        systemctl start cron >/dev/null 2>&1 || systemctl start crond >/dev/null 2>&1 || true
    fi
    save_meta "WATCHDOG_ENABLED" "1"
    init_pid_baselines
}

disable_watchdog() {
    if command_exists crontab; then
        crontab -l 2>/dev/null | grep -v "/usr/bin/sb -w" | crontab - 2>/dev/null || true
    elif [ -f /etc/crontabs/root ]; then
        grep -v "/usr/bin/sb -w" /etc/crontabs/root > /etc/crontabs/root.tmp 2>/dev/null || true
        mv -f /etc/crontabs/root.tmp /etc/crontabs/root
    fi
    save_meta "WATCHDOG_ENABLED" "0"
}

log_watchdog_event() {
    local msg="$1"
    mkdir -p "$work_dir"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ${msg}" >> "$watchdog_log"
    if [ "$(wc -l < "$watchdog_log" 2>/dev/null || echo 0)" -gt 50 ]; then
        tail -n 50 "$watchdog_log" > "${watchdog_log}.tmp" && mv -f "${watchdog_log}.tmp" "$watchdog_log"
    fi
}

get_pid_state_file() {
    case "$1" in
        sing-box) echo "${work_dir}/.sb_last_pid" ;;
        argo)     echo "${work_dir}/.argo_last_pid" ;;
        *)        echo "" ;;
    esac
}

# 精确获取存活进程 PID (排除 supervise-daemon 外壳与僵尸进程，兼容 Alpine/Debian)
get_live_pid() {
    local bin_path="$1"
    local proc_name="$2"
    local pid

    if command_exists pidof; then
        for pid in $(pidof "$proc_name" 2>/dev/null); do
            if [ -r "/proc/${pid}/stat" ]; then
                grep -q ") Z" "/proc/${pid}/stat" 2>/dev/null && continue
            fi
            echo "$pid"
            return 0
        done
    fi

    if command_exists pgrep; then
        for pid in $(pgrep -x "$proc_name" 2>/dev/null); do
            if [ -r "/proc/${pid}/stat" ]; then
                grep -q ") Z" "/proc/${pid}/stat" 2>/dev/null && continue
            fi
            echo "$pid"
            return 0
        done
    fi

    local pdir comm
    for pdir in /proc/[0-9]*; do
        [ -r "${pdir}/comm" ] || continue
        pid="${pdir#/proc/}"
        comm=$(cat "${pdir}/comm" 2>/dev/null)
        if [ "$comm" = "$proc_name" ]; then
            if [ -r "${pdir}/stat" ] && grep -q ") Z" "${pdir}/stat" 2>/dev/null; then
                continue
            fi
            echo "$pid"
            return 0
        fi
    done
    return 1
}

is_process_alive() {
    get_live_pid "$1" "$2" >/dev/null 2>&1
}

record_service_pid() {
    local service_name="$1"
    local svc_bin state_file pid _w=0
    svc_bin=$(get_service_file "$service_name")
    state_file=$(get_pid_state_file "$service_name")
    [ -z "$svc_bin" ] || [ -z "$state_file" ] && return 0

    mkdir -p "$work_dir"
    while [ "$_w" -lt 15 ]; do
        pid=$(get_live_pid "$svc_bin" "$service_name")
        if [ -n "$pid" ]; then
            echo "$pid" > "$state_file"
            return 0
        fi
        sleep 0.1
        _w=$((_w + 1))
    done
    return 1
}

clear_service_pid() {
    local state_file
    state_file=$(get_pid_state_file "$1")
    [ -n "$state_file" ] && rm -f "$state_file"
}

init_pid_baselines() {
    local svc state_file svc_bin cur_pid
    for svc in sing-box argo; do
        state_file=$(get_pid_state_file "$svc")
        svc_bin=$(get_service_file "$svc")
        if [ -n "$state_file" ] && [ ! -f "$state_file" ] && [ -x "$svc_bin" ]; then
            cur_pid=$(get_live_pid "$svc_bin" "$svc")
            if [ -n "$cur_pid" ]; then
                mkdir -p "$work_dir"
                echo "$cur_pid" > "$state_file"
            fi
        fi
    done
}

# 检测第一层守护 (supervise-daemon / systemd) 是否已完成秒级重启并记录日志
check_layer1_respawn() {
    local service_name="$1"
    local svc_bin state_file cur_pid last_pid respawn_time
    svc_bin=$(get_service_file "$service_name")
    state_file=$(get_pid_state_file "$service_name")
    [ -z "$svc_bin" ] || [ -z "$state_file" ] && return 1

    cur_pid=$(get_live_pid "$svc_bin" "$service_name")
    [ -z "$cur_pid" ] && return 1

    if [ -f "$state_file" ]; then
        last_pid=$(tr -d ' \t\r\n' < "$state_file" 2>/dev/null)
        if [ -n "$last_pid" ] && [ "$last_pid" != "$cur_pid" ]; then
            echo "$cur_pid" > "$state_file"
            respawn_time=""
            if [ -d "/proc/${cur_pid}" ]; then
                respawn_time=$(date -r "/proc/${cur_pid}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)
            fi
            if [ -n "$respawn_time" ]; then
                log_watchdog_event "[第一层秒级守护] 检测到 ${service_name} 异常退出后已自动秒级重启 (PID: ${last_pid} -> ${cur_pid} | 拉起时间: ${respawn_time})。"
            else
                log_watchdog_event "[第一层秒级守护] 检测到 ${service_name} 异常退出后已自动秒级重启 (PID: ${last_pid} -> ${cur_pid})。"
            fi
            return 0
        fi
    else
        mkdir -p "$work_dir"
        echo "$cur_pid" > "$state_file"
    fi
    return 1
}

# 看门狗单次执行逻辑 (由 cron 每分钟调用，执行完立即退出不占内存)
run_watchdog() {
    restore_firewall_rules

    if [ -x "${work_dir}/${server_name}" ] && is_service_registered "sing-box"; then
        if ! is_process_alive "${work_dir}/${server_name}" "sing-box"; then
            restart_singbox >/dev/null 2>&1 || true
            local new_sb_pid
            new_sb_pid=$(get_live_pid "${work_dir}/${server_name}" "sing-box")
            log_watchdog_event "[第二层定时巡检] 检测到 sing-box 进程异常/OOM退出，已由看门狗自动拉起重启${new_sb_pid:+ (新PID: ${new_sb_pid})}。"
        else
            check_layer1_respawn "sing-box" >/dev/null 2>&1 || true
        fi
    fi

    load_meta
    if [ "${ARGO_STOPPED:-0}" != "1" ] && proto_exists "vmess-ws" && [ -x "${work_dir}/argo" ] && is_service_registered "argo"; then
        if ! is_process_alive "${work_dir}/argo" "argo"; then
            if [ -z "$ARGO_TOKEN" ]; then
                get_quick_tunnel >/dev/null 2>&1 || true
                rebuild_urls >/dev/null 2>&1 || true
            else
                restart_argo >/dev/null 2>&1 || true
            fi
            local new_argo_pid
            new_argo_pid=$(get_live_pid "${work_dir}/argo" "argo")
            log_watchdog_event "[第二层定时巡检] 检测到 Argo 隧道进程异常退出，已自动拉起重启并刷新订阅${new_argo_pid:+ (新PID: ${new_argo_pid})}。"
        else
            check_layer1_respawn "argo" >/dev/null 2>&1 || true
            if [ -z "$ARGO_TOKEN" ]; then
                if sync_latest_argo_domain; then
                    rebuild_urls >/dev/null 2>&1 || true
                    log_watchdog_event "[Argo域名同步] 检测到 Argo 重启后临时域名变更为 ${ARGO_DOMAIN}，已自动更新节点订阅。"
                elif [ -f "${work_dir}/argo.log" ] && ! grep -q "trycloudflare\.com" "${work_dir}/argo.log" 2>/dev/null; then
                    get_quick_tunnel >/dev/null 2>&1 || true
                    rebuild_urls >/dev/null 2>&1 || true
                    log_watchdog_event "[第二层定时巡检] 检测到 Argo 临时域名缺失，已重新握手获取新域名。"
                fi
            fi
        fi
    fi

    if [ -f "${work_dir}/sb.log" ] && [ "$(wc -c < "${work_dir}/sb.log" 2>/dev/null || echo 0)" -gt 262144 ]; then
        tail -n 100 "${work_dir}/sb.log" > "${work_dir}/sb.log.tmp" 2>/dev/null && mv -f "${work_dir}/sb.log.tmp" "${work_dir}/sb.log"
    fi
    if [ -f "${work_dir}/argo.log" ] && [ "$(wc -c < "${work_dir}/argo.log" 2>/dev/null || echo 0)" -gt 262144 ]; then
        {
            grep "trycloudflare\.com" "${work_dir}/argo.log" 2>/dev/null | tail -n 2
            tail -n 80 "${work_dir}/argo.log" 2>/dev/null
