}

trap 'red "\n已退出脚本"; exit 0' INT

init_pid_baselines

case "$1" in
    -c | --check)
        check_nodes
        exit 0
        ;;
    -u | --uninstall)
        perform_full_uninstall
        exit 0
        ;;
    -r | --restart)
        restart_singbox
        if proto_exists "vmess-ws"; then
            save_meta "ARGO_STOPPED" "0"
            get_quick_tunnel
        fi
        rebuild_urls
        check_nodes
        exit 0
        ;;
    -w | --watchdog)
        run_watchdog
        exit 0
        ;;
    --apply-guard)
        apply_guard_and_optimize
        exit 0
        ;;
    -bon | --bbr-on)
        enable_bbr
        exit 0
        ;;
    -boff | --bbr-off | -d | --disable-bbr)
        disable_bbr
        exit 0
        ;;
    --doh-on | --doh)
        enable_doh "${2:-8.8.8.8}" "${3:-}"
        exit $?
        ;;
    --doh-off)
        disable_doh
        exit $?
        ;;
    -t | --test)
        test_nodes_health
        exit 0
        ;;
    -s | --speed)
        run_speedtest
        exit 0
        ;;
    -h | --help)
        echo ""
        green "快捷键用法: sb [参数]"
        green "  sb                   打开交互式管理菜单"
        green "  sb -c                直接输出节点 Base64 编码 (自动同步最新Argo域名)"
        green "  sb -t                执行节点运行、连通性与抗探测合规自检"
        green "  sb -s                执行服务器单线程轻量测速"
        green "  sb --apply-guard     无损启用断联自动重启守护与 64M 防崩溃优化"
        green "  sb -w                执行一次进程存活看门狗巡检"
        green "  sb -boff             直接关闭 BBR 加速通道 (或 sb --bbr-off)"
        green "  sb -bon              直接开启 BBR 加速通道 (或 sb --bbr-on)"
        green "  sb --doh-on [IP]     开启加密 DoH (默认 8.8.8.8，自动匹配 Host/SNI)"
        green "  sb --doh-off         恢复系统默认 DNS (local)"
        green "  sb -r                重启服务、刷新 Argo 临时域名并输出 Base64"
        green "  sb -u                直接彻底卸载并恢复初始状态"
        echo ""
        exit 0
        ;;
    "")
        while true; do
            menu
            reading "请输入选择 (0-13): " choice
            echo ""
            need_pause=true
            case "${choice}" in
                1)
                    if [ "$(check_service_raw sing-box)" != "not installed" ]; then
                        reading "检测到 sing-box 已安装，是否覆盖重新安装并重设端口/协议？(y/n): " reinstall_yn
                        [[ ! "$reinstall_yn" =~ ^[yY]$ ]] && continue
                        clean_firewall_rules
                        : > "$ports_file" 2>/dev/null || true
                    fi
                    manage_packages install jq tar openssl lsof coreutils curl
                    install_singbox
                    if command_exists systemctl; then
                        main_systemd_services
                    elif command_exists rc-update; then
                        alpine_openrc_services
                    else
                        red "不支持的 init 系统"; exit 1
                    fi
                    enable_watchdog
                    ensure_sb_links
                    sleep 2
                    get_info
                    ;;
                2)  uninstall_singbox;       need_pause=false ;;
                3)  check_nodes;             need_pause=true ;;
                4)  manage_protocols;        need_pause=false ;;
                5)
                    configure_inbound_stack_and_ip
                    restart_singbox
                    rebuild_urls
                    check_nodes
                    need_pause=true
                    ;;
                6)  change_config;           need_pause=true ;;
                7)  manage_singbox;          need_pause=true ;;
                8)  manage_argo;             need_pause=true ;;
                9)  warp_manage;             need_pause=true ;;
                10) manage_bbr_menu;         need_pause=true ;;
                11) manage_watchdog_menu;    need_pause=true ;;
                12) manage_dns_menu;         need_pause=true ;;
                13) manage_test_speed_menu;  need_pause=true ;;
                0)  exit 0 ;;
                *)  red "无效的选项，请输入 0-13"; need_pause=true ;;
            esac
            [ "$need_pause" = true ] && read -n 1 -s -r -p $'\033[1;91m按任意键返回主菜单...\033[0m'
        done
        ;;
    *)
        red "未知参数: $1 (输入 sb -h 查看可用参数)"
        exit 1
        ;;
esac
